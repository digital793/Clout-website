# ─────────────────────────────────────────────────────────────
# Cloutgency — Environment Configuration
# Copy this file to .env and fill in your production values
# ─────────────────────────────────────────────────────────────

# Server Port and Environment
PORT=3000
NODE_ENV=production

# Database (Hostinger MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_clout
DB_PASSWORD=your_secure_db_password
DB_NAME=u123456789_cloutgency

# Email (Hostinger Titan SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@cloutgency.com
SMTP_PASS=your_email_password
CONTACT_RECEIVER=hello@cloutgency.com

# Domain / Canonical URLs
SITE_URL=https://cloutgency.com
SITE_NAME=Cloutgency
