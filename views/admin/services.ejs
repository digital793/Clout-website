<%- include('layout', {
  body: `
  <style>
    .s-head { display:flex; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom:22px; flex-wrap:wrap; }
    .s-head h2 { font-size:22px; font-weight:800; color:#fff; }
    .s-head p { font-size:12px; color:var(--text-muted); margin-top:2px; }
    .s-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:20px; }
    .s-card { background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--radius-md); overflow:hidden; display:flex; flex-direction:column; transition:var(--transition); }
    .s-card:hover { border-color:var(--border-gold); transform:translateY(-2px); }
    .s-card.hidden-item { opacity:.5; }
    .s-media { position:relative; aspect-ratio:1; background:#0a090e; overflow:hidden; }
    .s-media img, .s-media video { width:100%; height:100%; object-fit:cover; display:block; }
    .s-num { position:absolute; top:10px; left:10px; background:rgba(0,0,0,.8); color:var(--gold); font-size:11px; font-weight:800; padding:3px 8px; border-radius:6px; border:1px solid rgba(255,215,0,.35); }
    .s-flag { position:absolute; top:10px; right:10px; background:rgba(0,0,0,.8); color:#ff6b6b; font-size:10px; font-weight:800; padding:3px 8px; border-radius:6px; }
    .s-body { padding:16px; display:flex; flex-direction:column; flex:1; }
    .s-name { font-size:16px; font-weight:800; color:#fff; }
    .s-line { font-size:12px; color:var(--text-muted); line-height:1.5; margin:6px 0 10px; }
    .s-points { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; flex:1; align-content:flex-start; }
    .s-points span { font-size:10.5px; font-weight:700; color:var(--gold); border:1px solid rgba(255,215,0,.3); border-radius:999px; padding:3px 9px; }
    .s-actions { display:flex; gap:8px; padding-top:12px; border-top:1px solid var(--border-subtle); }
    .s-form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    @media (max-width:640px) { .s-form-row { grid-template-columns:1fr; } }
    .s-upload { display:flex; gap:10px; align-items:center; margin-top:8px; flex-wrap:wrap; }
    .s-preview { margin-top:10px; width:150px; aspect-ratio:1; border-radius:8px; overflow:hidden; background:#0a090e; border:1px solid var(--border-subtle); display:none; }
    .s-preview img, .s-preview video { width:100%; height:100%; object-fit:cover; }
    .s-hint { font-size:11.5px; color:var(--text-muted); margin-top:6px; line-height:1.5; }
    .s-switch { display:flex; align-items:center; gap:10px; font-size:13px; color:#fff; cursor:pointer; }
    .s-btn-secondary { background:rgba(255,255,255,.05); border:1px solid var(--border-subtle); color:#fff; border-radius:999px; padding:9px 16px; font-weight:700; font-size:13px; cursor:pointer; }
  </style>

  <div class="s-head">
    <div>
      <h2>Services</h2>
      <p>The cards in the homepage services cube. Changes show on the homepage straight away.</p>
    </div>
    <button type="button" class="btn-action-gold" id="btnNew">+ Add New Entry</button>
  </div>

  <div id="sList"></div>

  <div class="modal-backdrop" id="sModal">
    <div class="modal-box" style="max-width:720px;">
      <h3 style="font-size:18px;font-weight:800;color:#fff;margin-bottom:18px;" id="sModalTitle">Add service</h3>
      <form id="sForm" autocomplete="off">
        <input type="hidden" id="fId">
        <div class="s-form-row">
          <div class="form-group">
            <label class="form-label">Service name *</label>
            <input type="text" class="form-control" id="fName" maxlength="60" placeholder="e.g. Branding">
          </div>
          <div class="form-group">
            <label class="form-label">Position in the cube</label>
            <input type="number" class="form-control" id="fOrder" min="1" step="1" placeholder="1 = first">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">One-line description</label>
          <input type="text" class="form-control" id="fLine" maxlength="200" placeholder="e.g. Identity built to convert, not just look pretty.">
        </div>
        <div class="form-group">
          <label class="form-label">Points (one per line, up to 8)</label>
          <textarea class="form-control" id="fPoints" rows="4" placeholder="Identity&#10;Strategy&#10;Positioning&#10;Guidelines"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Video or image *</label>
          <input type="text" class="form-control" id="fMedia" placeholder="/videos/... or /images/... or https://...">
          <div class="s-upload">
            <button type="button" class="s-btn-secondary" id="btnUpVideo">Upload video</button>
            <button type="button" class="s-btn-secondary" id="btnUpImage">Upload image</button>
            <input type="file" id="fileVideo" accept="video/mp4,video/webm" hidden>
            <input type="file" id="fileImage" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
          </div>
          <div class="s-hint">Shown square on the cube face. Compress videos for the web first so they load fast.</div>
          <div class="s-preview" id="prevMedia"></div>
        </div>
        <div class="s-form-row">
          <div class="form-group">
            <label class="form-label">Cover image (for videos)</label>
            <input type="text" class="form-control" id="fPoster" placeholder="/videos/....jpg or /images/...">
            <div class="s-upload"><button type="button" class="s-btn-secondary" id="btnUpPoster">Upload cover</button>
              <input type="file" id="filePoster" accept="image/jpeg,image/png,image/webp" hidden></div>
            <div class="s-preview" id="prevPoster"></div>
          </div>
          <div class="form-group">
            <label class="form-label">Image description (for accessibility)</label>
            <input type="text" class="form-control" id="fAlt" maxlength="120" placeholder="e.g. Branding work">
          </div>
        </div>
        <label class="s-switch"><input type="checkbox" id="fActive" checked> Show this service in the cube</label>
        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:22px;">
          <button type="button" class="s-btn-secondary" id="btnCancel">Cancel</button>
          <button type="submit" class="btn-action-gold" id="btnSave">Save Entry ✦</button>
        </div>
      </form>
    </div>
  </div>

  <script>
  (function () {
    var ITEMS = ${JSON.stringify(items).replace(/</g, '\\u003c')};
    var list = document.getElementById('sList');
    var modal = document.getElementById('sModal');
    var $ = function (id) { return document.getElementById(id); };
    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function isVideo(u) { return /\\.(mp4|webm)(\\?|#|$)/i.test(u || ''); }
    function mediaTag(u, poster) {
      // show a real frame from the video (some cover files are blank)
      if (!u && poster) return '<img src="' + esc(poster) + '" alt="" loading="lazy">';
      if (!u) return '<div style="display:grid;place-items:center;height:100%;color:var(--text-dim);font-size:11px;">No media</div>';
      return isVideo(u) ? '<video src="' + esc(u) + '#t=1" muted preload="metadata"></video>' : '<img src="' + esc(u) + '" alt="" loading="lazy">';
    }

    function render() {
      if (!ITEMS.length) {
        list.innerHTML = '<div class="glass-panel" style="text-align:center;padding:60px 24px;"><p style="font-size:14px;font-weight:700;color:#fff;margin-bottom:6px;">No services yet</p>' +
          '<p style="font-size:12px;color:var(--text-muted);margin-bottom:18px;">The services cube is empty until you add one.</p>' +
          '<button type="button" class="btn-action-gold" onclick="document.getElementById(\\'btnNew\\').click()">+ Add First Entry</button></div>';
        return;
      }
      var shown = 0;
      list.innerHTML = '<div class="s-grid">' + ITEMS.map(function (s) {
        var num = s.isActive === false ? '–' : String(++shown).padStart(2, '0');
        return '<div class="s-card' + (s.isActive === false ? ' hidden-item' : '') + '">' +
          '<div class="s-media">' + mediaTag(s.media, s.poster) + '<span class="s-num">' + num + '</span>' +
          (s.isActive === false ? '<span class="s-flag">HIDDEN</span>' : '') + '</div>' +
          '<div class="s-body"><div class="s-name">' + esc(s.name) + '</div>' +
          '<div class="s-line">' + esc(s.line || '') + '</div>' +
          '<div class="s-points">' + (s.points || []).map(function (p) { return '<span>' + esc(p) + '</span>'; }).join('') + '</div>' +
          '<div class="s-actions"><button type="button" class="btn-edit-item" style="flex:1;" data-edit="' + s.id + '">Edit ✎</button>' +
          '<button type="button" class="btn-del-item" data-del="' + s.id + '" title="Delete">✕</button></div></div></div>';
      }).join('') + '</div>';
    }

    function preview(boxId, url) {
      var box = $(boxId);
      if (!url) { box.style.display = 'none'; box.innerHTML = ''; return; }
      box.style.display = 'block';
      box.innerHTML = isVideo(url) ? '<video src="' + esc(url) + '#t=1" muted controls preload="metadata"></video>' : '<img src="' + esc(url) + '" alt="">';
    }

    function openModal(item) {
      item = item || {};
      $('sModalTitle').textContent = item.id ? 'Edit service' : 'Add service';
      $('fId').value = item.id || '';
      $('fName').value = item.name || '';
      $('fOrder').value = item.sortOrder || '';
      $('fLine').value = item.line || '';
      $('fPoints').value = (item.points || []).join('\\n');
      $('fMedia').value = item.media || '';
      $('fPoster').value = item.poster || '';
      $('fAlt').value = item.alt || '';
      $('fActive').checked = item.isActive !== false;
      preview('prevMedia', item.media);
      preview('prevPoster', item.poster);
      modal.classList.add('show');
    }
    function closeModal() { modal.classList.remove('show'); }
    $('btnNew').addEventListener('click', function () { openModal(null); });
    $('btnCancel').addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    $('fMedia').addEventListener('change', function () { preview('prevMedia', this.value.trim()); });
    $('fPoster').addEventListener('change', function () { preview('prevPoster', this.value.trim()); });

    list.addEventListener('click', function (e) {
      var ed = e.target.closest('[data-edit]');
      var del = e.target.closest('[data-del]');
      if (ed) openModal(ITEMS.find(function (s) { return String(s.id) === ed.dataset.edit; }));
      if (del) removeItem(del.dataset.del);
    });

    function upload(kind, file, input, boxId, btn) {
      var label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Uploading…';
      var fd = new FormData(); fd.append('file', file);
      fetch('/api/admin/services/upload/' + kind, { method: 'POST', body: fd, headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.success) throw new Error(res.error || 'Upload failed');
          input.value = res.url; preview(boxId, res.url);
          showToast(kind === 'video' ? 'Video uploaded' : 'Image uploaded');
        })
        .catch(function (err) { showToast(err.message, true); })
        .finally(function () { btn.disabled = false; btn.textContent = label; });
    }
    $('btnUpVideo').addEventListener('click', function () { $('fileVideo').click(); });
    $('btnUpImage').addEventListener('click', function () { $('fileImage').click(); });
    $('btnUpPoster').addEventListener('click', function () { $('filePoster').click(); });
    $('fileVideo').addEventListener('change', function () { if (this.files[0]) upload('video', this.files[0], $('fMedia'), 'prevMedia', $('btnUpVideo')); this.value = ''; });
    $('fileImage').addEventListener('change', function () { if (this.files[0]) upload('image', this.files[0], $('fMedia'), 'prevMedia', $('btnUpImage')); this.value = ''; });
    $('filePoster').addEventListener('change', function () { if (this.files[0]) upload('image', this.files[0], $('fPoster'), 'prevPoster', $('btnUpPoster')); this.value = ''; });

    $('sForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var payload = {
        id: $('fId').value || undefined,
        name: $('fName').value.trim(),
        sortOrder: $('fOrder').value,
        line: $('fLine').value.trim(),
        points: $('fPoints').value.split('\\n').map(function (p) { return p.trim(); }).filter(Boolean),
        media: $('fMedia').value.trim(),
        poster: $('fPoster').value.trim(),
        alt: $('fAlt').value.trim(),
        isActive: $('fActive').checked
      };
      if (!payload.name) { showToast('Add a service name', true); return; }
      if (!payload.media) { showToast('Add a video or image', true); return; }
      var btn = $('btnSave'); btn.disabled = true; btn.textContent = 'Saving…';
      fetch('/api/admin/collections/serviceCube', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload)
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.success) throw new Error(res.error || 'Save failed');
          showToast('Saved — the homepage cube is updated');
          setTimeout(function () { location.reload(); }, 500);
        })
        .catch(function (err) { showToast(err.message, true); btn.disabled = false; btn.textContent = 'Save Entry ✦'; });
    });

    function removeItem(id) {
      var item = ITEMS.find(function (s) { return String(s.id) === String(id); });
      if (!confirm('Delete the ' + (item ? item.name : '') + ' service? This cannot be undone. (To just hide it, use Edit and untick "Show".)')) return;
      fetch('/api/admin/collections/serviceCube/' + id, { method: 'DELETE', headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.success) throw new Error(res.error || 'Delete failed');
          ITEMS = ITEMS.filter(function (s) { return String(s.id) !== String(id); });
          render(); showToast('Service deleted');
        })
        .catch(function (err) { showToast(err.message, true); });
    }

    render();
  })();
  </script>
`}) %>
