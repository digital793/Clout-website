<%- include('layout', {
  body: `
  <style>
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 28px;
    }
    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 22px 24px;
      position: relative;
      overflow: hidden;
      transition: var(--transition);
    }
    .kpi-card:hover {
      border-color: var(--border-gold);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 215, 0, 0.05);
    }
    .kpi-label {
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .kpi-value {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
    }
    .kpi-sub {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--gold);
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .dashboard-split {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 24px;
      margin-bottom: 28px;
    }
    @media (max-width: 1080px) {
      .dashboard-split { grid-template-columns: 1fr; }
    }

    /* Traffic Bars */
    .traffic-bars {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      height: 180px;
      padding-top: 24px;
      margin-top: 16px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .bar-column {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      height: 100%;
      justify-content: flex-end;
    }
    .bar-fill {
      width: 100%;
      background: linear-gradient(180deg, var(--gold) 0%, rgba(255, 215, 0, 0.15) 100%);
      border-radius: 4px 4px 0 0;
      min-height: 4px;
      transition: height 0.4s ease;
      position: relative;
    }
    .bar-fill:hover {
      background: var(--gold-light);
      box-shadow: 0 0 12px var(--gold);
    }
    .bar-label {
      font-size: 10px;
      color: var(--text-dim);
      margin-top: 8px;
    }

    .top-pages-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }
    .page-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      font-size: 13px;
    }
    .page-path {
      font-weight: 700;
      color: #fff;
    }
    .page-count {
      color: var(--gold);
      font-weight: 700;
      font-size: 12px;
      background: rgba(255, 215, 0, 0.08);
      padding: 3px 8px;
      border-radius: 999px;
      border: 1px solid rgba(255, 215, 0, 0.2);
    }

    .submissions-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
    }
    .submissions-table th {
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-dim);
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .submissions-table td {
      padding: 14px 16px;
      font-size: 13px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      color: #ccc;
    }
    .submissions-table tr:hover td {
      background: rgba(255, 255, 255, 0.02);
      color: #fff;
    }

    .type-badge {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 999px;
    }
    .type-badge.contact {
      background: rgba(46, 213, 115, 0.15);
      color: #2ed573;
      border: 1px solid rgba(46, 213, 115, 0.3);
    }
    .type-badge.career {
      background: rgba(255, 215, 0, 0.15);
      color: var(--gold);
      border: 1px solid rgba(255, 215, 0, 0.3);
    }
  </style>

  <!-- KPI Top Stats -->
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">
        <span>Site Visits (24h)</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div class="kpi-value">${traffic.views24h || 0}</div>
      <div class="kpi-sub">
        <span>✦ Total: ${traffic.totalViews || 0} hits</span>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label">
        <span>Form Inquiries</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path></svg>
      </div>
      <div class="kpi-value">${stats.totalSubmissions || 0}</div>
      <div class="kpi-sub">
        <span>✦ Leads & Career Apps</span>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label">
        <span>Collection Entries</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
      </div>
      <div class="kpi-value">${stats.totalCollectionEntries || 0}</div>
      <div class="kpi-sub">
        <span>✦ Srv·${stats.totalServices} Works·${stats.totalWorks} Blog·${stats.totalBlogs} Team·${stats.totalTeam}</span>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label">
        <span>Active Works & Services</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon></svg>
      </div>
      <div class="kpi-value">${stats.totalServices + stats.totalWorks}</div>
      <div class="kpi-sub">
        <span>✦ CMS Synced</span>
      </div>
    </div>
  </div>

  <!-- Traffic Analytics Split -->
  <div class="dashboard-split">
    <div class="glass-panel gold-accent">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          <h3 style="font-size:16px; font-weight:800; color:#fff;">Live Traffic Activity (Last 24 Hours)</h3>
          <p style="font-size:12px; color:var(--text-muted); margin-top:2px;">Real-time visitor frequency per hourly window</p>
        </div>
        <span style="font-size:11px; font-weight:700; color:var(--gold); background:rgba(255,215,0,0.1); padding:4px 10px; border-radius:999px; border:1px solid rgba(255,215,0,0.25);">Active Tracking</span>
      </div>

      <div class="traffic-bars">
        ${(() => {
          const max = Math.max(...(traffic.hourly || [1]), 1);
          return (traffic.hourly || new Array(24).fill(0)).map((val, idx) => {
            const pct = Math.round((val / max) * 100);
            return `
              <div class="bar-column" title="${idx}:00 — ${val} views">
                <div class="bar-fill" style="height: ${Math.max(pct, 5)}%;"></div>
                <div class="bar-label">${idx % 4 === 0 ? idx + 'h' : ''}</div>
              </div>
            `;
          }).join('');
        })()}
      </div>
    </div>

    <div class="glass-panel">
      <h3 style="font-size:16px; font-weight:800; color:#fff;">Top Visited URLs</h3>
      <p style="font-size:12px; color:var(--text-muted); margin-top:2px;">Highest traffic pages this week</p>

      <div class="top-pages-list">
        ${(traffic.topPages && traffic.topPages.length > 0)
          ? traffic.topPages.map(p => `
              <div class="page-row">
                <span class="page-path">${p.path}</span>
                <span class="page-count">${p.count} views</span>
              </div>
            `).join('')
          : `
              <div class="page-row"><span class="page-path">/</span><span class="page-count">Active</span></div>
              <div class="page-row"><span class="page-path">/our-services</span><span class="page-count">Active</span></div>
              <div class="page-row"><span class="page-path">/our-works</span><span class="page-count">Active</span></div>
            `
        }
      </div>
    </div>
  </div>

  <!-- Recent Submissions Overview -->
  <div class="glass-panel">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
      <div>
        <h3 style="font-size:16px; font-weight:800; color:#fff;">Recent Inquiries & Leads</h3>
        <p style="font-size:12px; color:var(--text-muted); margin-top:2px;">Latest messages captured from contact and career forms</p>
      </div>
      <a href="/admin/forms" class="btn-live-preview" style="font-size:12px;">View All Submissions →</a>
    </div>

    ${(() => {
      const allSub = [
        ...(submissions.contact || []).map(c => ({ ...c, type: 'contact' })),
        ...(submissions.careers || []).map(a => ({ ...a, type: 'career' }))
      ].sort((a, b) => new Date(b.created_at || b.createdAt) - new Date(a.created_at || a.createdAt)).slice(0, 5);

      if (allSub.length === 0) {
        return '<p style="color:var(--text-dim); font-size:13px; padding:20px 0;">No form submissions received yet. Test by submitting the contact form on the live site!</p>';
      }

      return `
        <table class="submissions-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Service / Role</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            ${allSub.map(s => `
              <tr>
                <td><span class="type-badge ${s.type}">${s.type === 'contact' ? 'Inquiry' : 'Career'}</span></td>
                <td style="font-weight:700; color:#fff;">${s.name}</td>
                <td>${s.email}</td>
                <td>${s.phone || '—'}</td>
                <td style="color:var(--gold); font-weight:600;">${s.service || s.role || 'General'}</td>
                <td>${new Date(s.created_at || s.createdAt).toLocaleDateString()}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    })()}
  </div>
`}) %>
