<% 
  /* Normalize: routes may pass 'user' or 'currentUser' as locals */
  const _adminUser = (typeof user !== 'undefined' && user) ? user : null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- typeof title !== 'undefined' ? title : 'Cloutgency CMS — Executive Studio' %></title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/cloutgency.css">

  <style>
    :root {
      --bg-base: #060505;
      --bg-surface: #0e0d10;
      --bg-card: rgba(18, 17, 22, 0.72);
      --bg-card-hover: rgba(26, 25, 32, 0.85);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-gold: rgba(255, 215, 0, 0.22);
      --gold: #FFD700;
      --gold-glow: rgba(255, 215, 0, 0.35);
      --gold-light: #FFE566;
      --text-main: #FFFFFF;
      --text-muted: #9A9AA2;
      --text-dim: #60606A;
      --danger: #FF4757;
      --success: #2ED573;
      --sidebar-w: 260px;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: 'Lufga', 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
    }

    /* ─── Ambient Glow ──────────────────────────────────────────────────────── */
    .ambient-glow {
      position: fixed;
      top: -10vw;
      right: -10vw;
      width: 45vw;
      height: 45vw;
      background: radial-gradient(circle, rgba(255, 215, 0, 0.055) 0%, rgba(6, 5, 5, 0) 70%);
      pointer-events: none;
      z-index: 0;
    }
    .ambient-glow-2 {
      position: fixed;
      bottom: -15vw;
      left: 15vw;
      width: 40vw;
      height: 40vw;
      background: radial-gradient(circle, rgba(255, 215, 0, 0.035) 0%, rgba(6, 5, 5, 0) 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* ─── Sidebar ────────────────────────────────────────────────────────────── */
    .admin-sidebar {
      width: var(--sidebar-w);
      background: rgba(11, 10, 14, 0.85);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: sticky;
      top: 0;
      z-index: 50;
      flex-shrink: 0;
    }

    .sidebar-header {
      padding: 24px 22px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .brand-logo-mark {
      width: 38px;
      height: 38px;
      background: #000;
      border: 1px solid var(--border-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 15px var(--gold-glow);
    }

    .brand-logo-mark img {
      width: 22px;
      height: 22px;
    }

    .brand-title {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
    }
    .brand-title span {
      color: var(--gold);
    }
    .brand-subtitle {
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--gold);
      opacity: 0.85;
    }

    .sidebar-nav {
      flex: 1;
      padding: 16px 12px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .nav-category {
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      padding: 14px 12px 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      transition: var(--transition);
      position: relative;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.04);
      color: #fff;
    }

    .nav-item.active {
      background: rgba(255, 215, 0, 0.09);
      color: var(--gold);
      border: 1px solid rgba(255, 215, 0, 0.22);
      box-shadow: inset 0 0 12px rgba(255, 215, 0, 0.06);
    }

    .nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 25%;
      height: 50%;
      width: 3px;
      background: var(--gold);
      border-radius: 0 4px 4px 0;
      box-shadow: 0 0 8px var(--gold);
    }

    .nav-item svg {
      width: 17px;
      height: 17px;
      stroke-width: 2;
      flex-shrink: 0;
    }

    .nav-badge {
      margin-left: auto;
      background: rgba(255, 215, 0, 0.18);
      color: var(--gold);
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 999px;
      border: 1px solid rgba(255, 215, 0, 0.3);
    }

    .sidebar-footer {
      padding: 16px;
      border-top: 1px solid var(--border-subtle);
      background: rgba(8, 7, 10, 0.95);
    }

    .user-profile-card {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--gold) 0%, #b8860b 100%);
      color: #000;
      font-weight: 800;
      font-size: 13px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .user-info {
      flex: 1;
      overflow: hidden;
    }
    .user-name {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }
    .user-role-badge {
      font-size: 10px;
      font-weight: 700;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .logout-btn {
      color: var(--text-dim);
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
      transition: var(--transition);
      display: flex;
      align-items: center;
      text-decoration: none;
    }
    .logout-btn:hover {
      color: var(--danger);
      transform: translateX(2px);
    }

    /* ─── Main Content Canvas ────────────────────────────────────────────────── */
    .admin-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      position: relative;
      z-index: 1;
    }

    /* ─── Top Navbar ─────────────────────────────────────────────────────────── */
    .admin-topbar {
      height: 70px;
      padding: 0 32px;
      background: rgba(11, 10, 14, 0.65);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .page-title-badge {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .page-title-badge::before {
      content: '';
      width: 7px;
      height: 7px;
      background: var(--gold);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--gold);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .btn-live-preview {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: #fff;
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
    }
    .btn-live-preview:hover {
      background: rgba(255, 215, 0, 0.12);
      border-color: var(--border-gold);
      color: var(--gold);
      box-shadow: 0 0 16px rgba(255, 215, 0, 0.15);
    }

    .btn-action-gold {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--gold);
      color: #000;
      font-size: 13px;
      font-weight: 700;
      padding: 9px 18px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }
    .btn-action-gold:hover {
      background: var(--gold-light);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px var(--gold-glow);
    }

    .admin-body {
      padding: 32px;
      flex: 1;
    }

    /* ─── Glass Cards & Inputs ──────────────────────────────────────────────── */
    .glass-panel {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 24px;
      position: relative;
      overflow: hidden;
      transition: var(--transition);
    }
    .glass-panel:hover {
      border-color: rgba(255, 255, 255, 0.12);
    }
    .glass-panel.gold-accent {
      border-color: var(--border-gold);
      box-shadow: 0 0 25px rgba(255, 215, 0, 0.04);
    }

    .form-group {
      margin-bottom: 20px;
    }
    .form-label {
      display: block;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .form-control {
      width: 100%;
      background: rgba(6, 5, 8, 0.8);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      color: #fff;
      font-size: 14px;
      font-family: inherit;
      transition: var(--transition);
      outline: none;
    }
    .form-control:focus {
      border-color: var(--gold);
      box-shadow: 0 0 14px rgba(255, 215, 0, 0.2);
    }
    textarea.form-control {
      min-height: 100px;
      resize: vertical;
    }

    /* ─── Role / Type Badges ─────────────────────────────────────────────────── */
    .type-badge {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 999px;
    }
    .type-badge.contact {
      background: rgba(46, 213, 115, 0.15);
      color: #2ed573;
      border: 1px solid rgba(46, 213, 115, 0.3);
    }
    .type-badge.career {
      background: rgba(255, 215, 0, 0.15);
      color: var(--gold);
      border: 1px solid rgba(255, 215, 0, 0.3);
    }

    /* ─── Shared Button Variants ────────────────────────────────────────────── */
    .btn-edit-item {
      flex: 1;
      padding: 8px;
      background: rgba(255, 215, 0, 0.1);
      border: 1px solid rgba(255, 215, 0, 0.25);
      color: var(--gold);
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-edit-item:hover {
      background: var(--gold);
      color: #000;
    }
    .btn-del-item {
      padding: 8px 12px;
      background: rgba(255, 71, 87, 0.1);
      border: 1px solid rgba(255, 71, 87, 0.25);
      color: #ff6b81;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-del-item:hover {
      background: #ff4757;
      color: #fff;
    }

    /* ─── Shared Modal & Fullscreen Isolation ────────────────────────────────── */
    body.modal-open,
    body:has(.modal-backdrop.show) {
      overflow: hidden;
    }
    body.modal-open .admin-main,
    body:has(.modal-backdrop.show) .admin-main {
      z-index: 10000 !important;
    }
    body.modal-open .admin-sidebar,
    body:has(.modal-backdrop.show) .admin-sidebar {
      z-index: 1 !important;
    }
    /* When Fullscreen Blog Studio is active: completely hide sidebar and topbar */
    body.blog-studio-active .admin-sidebar,
    body:has(.blog-fullscreen-backdrop.show) .admin-sidebar {
      display: none !important;
    }
    body.blog-studio-active .admin-topbar,
    body:has(.blog-fullscreen-backdrop.show) .admin-topbar {
      display: none !important;
    }
    body.blog-studio-active .admin-body,
    body:has(.blog-fullscreen-backdrop.show) .admin-body {
      padding: 0 !important;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(10px);
      z-index: 99999 !important;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-backdrop.show {
      display: flex;
    }
    .modal-box {
      width: 100%;
      max-width: 600px;
      max-height: 90vh;
      overflow-y: auto;
      background: #111015;
      border: 1px solid var(--border-gold);
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.9), 0 0 30px var(--gold-glow);
    }

    /* ─── Toast Notifications ────────────────────────────────────────────────── */
    #toastContainer {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .toast-msg {
      background: #141318;
      border: 1px solid var(--border-gold);
      color: #fff;
      padding: 14px 20px;
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      font-weight: 600;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px var(--gold-glow);
      display: flex;
      align-items: center;
      gap: 12px;
      animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes toastIn {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="ambient-glow"></div>
  <div class="ambient-glow-2"></div>

  <!-- ─── Sidebar ──────────────────────────────────────────────────────────── -->
  <aside class="admin-sidebar">
    <div class="sidebar-header">
      <div class="brand-logo-mark">
        <img src="/images/group-c-logo.svg" alt="Cloutgency">
      </div>
      <div>
        <div class="brand-title">CLOUT<span>GENCY</span></div>
        <div class="brand-subtitle">Executive CMS</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-category">Core Overview</div>
      <a href="/admin/dashboard" class="nav-item <%- activeTab === 'dashboard' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        <span>Dashboard</span>
      </a>

      <a href="/admin/forms" class="nav-item <%- activeTab === 'forms' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        <span>Form Inquiries</span>
        <span class="nav-badge" id="sidebarSubmissionsBadge">Live</span>
      </a>


      <div class="nav-category">Content Collections</div>
      <a href="/admin/collections/services" class="nav-item <%- activeTab === 'services' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        <span>Services</span>
      </a>

      <a href="/admin/collections/works" class="nav-item <%- activeTab === 'works' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        <span>Our Works</span>
      </a>

      <a href="/admin/collections/case_studies" class="nav-item <%- activeTab === 'case_studies' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        <span>Case Studies</span>
      </a>

      <a href="/admin/collections/blogs" class="nav-item <%- activeTab === 'blogs' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
        <span>Blogs & Articles</span>
      </a>

      <a href="/admin/collections/team" class="nav-item <%- activeTab === 'team' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        <span>Team</span>
      </a>

      <a href="/admin/collections/testimonials" class="nav-item <%- activeTab === 'testimonials' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Testimonials</span>
      </a>

      <div class="nav-category">System & Growth</div>
      <a href="/admin/pages" class="nav-item <%- activeTab === 'pages' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="13" y2="17"></line></svg>
        <span>Pages Editor</span>
      </a>

      <a href="/admin/seo" class="nav-item <%- activeTab === 'seo' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        <span>SEO & Metadata</span>
      </a>

      <a href="/admin/media" class="nav-item <%- activeTab === 'assets' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span>Media Manager</span>
      </a>

      <% const _cu = (typeof _adminUser !== 'undefined' ? _adminUser : (typeof user !== 'undefined' ? user : null)); %>
      <% if (_cu && (_cu.role === 'superadmin' || (_cu.privileges && _cu.privileges.includes('users')))) { %>
      <a href="/admin/users" class="nav-item <%- activeTab === 'users' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        <span>User Permissions</span>
      </a>
      <% } %>
    </nav>

    <div class="sidebar-footer">
      <div class="user-profile-card">
        <div class="user-avatar">
          <%= (_adminUser && _adminUser.username ? _adminUser.username[0].toUpperCase() : 'A') %>
        </div>
        <div class="user-info">
          <div class="user-name"><%= _adminUser ? _adminUser.username : 'Admin' %></div>
          <div class="user-role-badge"><%= _adminUser ? _adminUser.role : 'Super Admin' %></div>
        </div>
        <a href="/admin/logout" class="logout-btn" title="Sign Out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        </a>
      </div>
    </div>
  </aside>

  <!-- ─── Main Viewport ─────────────────────────────────────────────────────── -->
  <main class="admin-main">
    <header class="admin-topbar">
      <div class="topbar-left">
        <div class="page-title-badge">
          <span><%= title.split('—')[0].trim() %></span>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/" target="_blank" class="btn-live-preview">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
