<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Executive Login — Cloutgency Studio</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'Lufga';
      src: url('/fonts/LufgaRegular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Lufga';
      src: url('/fonts/LufgaMedium.ttf') format('truetype');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Lufga';
      src: url('/fonts/LufgaSemiBold.ttf') format('truetype');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Lufga';
      src: url('/fonts/LufgaBold.ttf') format('truetype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Lufga';
      src: url('/fonts/LufgaExtraBold.ttf') format('truetype');
      font-weight: 800;
      font-style: normal;
      font-display: swap;
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }
    body {
      background: #060505;
      color: #fff;
      font-family: 'Lufga', 'Outfit', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 20px;
    }
    .ambient-glow {
      position: absolute;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(255, 215, 0, 0.12) 0%, rgba(6, 5, 5, 0) 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }
    .login-container {
      width: 100%;
      max-width: 420px;
      background: rgba(14, 13, 18, 0.85);
      border: 1px solid rgba(255, 215, 0, 0.22);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border-radius: 20px;
      padding: 40px 36px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(255, 215, 0, 0.06);
      position: relative;
      z-index: 10;
    }
    .login-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .brand-mark {
      width: 56px;
      height: 56px;
      background: #000;
      border: 1px solid rgba(255, 215, 0, 0.35);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      box-shadow: 0 0 25px rgba(255, 215, 0, 0.3);
    }
    .brand-mark img {
      width: 32px;
      height: 32px;
    }
    .title {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #FFFFFF;
      line-height: 1.2;
    }
    .title span {
      color: #FFD700;
    }
    .subtitle {
      font-size: 12.5px;
      color: #9A9AA2;
      margin-top: 4px;
    }
    .alert-error {
      background: rgba(255, 71, 87, 0.12);
      border: 1px solid rgba(255, 71, 87, 0.3);
      color: #FF6B81;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-label {
      display: block;
      font-size: 11.5px;
      font-weight: 700;
      color: #A0A0AA;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }
    .form-input {
      width: 100%;
      background: rgba(6, 5, 8, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 10px;
      padding: 13px 16px;
      color: #FFFFFF;
      font-size: 14px;
      line-height: 1.4;
      outline: none;
      transition: all 0.2s ease;
      font-family: inherit;
      text-transform: none;
    }
    .form-input::placeholder {
      color: rgba(255, 255, 255, 0.45);
      opacity: 1;
    }
    .form-input:hover {
      border-color: rgba(255, 255, 255, 0.28);
      background: rgba(12, 10, 16, 0.95);
    }
    .form-input:focus {
      border-color: #FFD700;
      color: #FFFFFF;
      background: rgba(12, 10, 16, 0.95);
      box-shadow: 0 0 16px rgba(255, 215, 0, 0.2);
    }
    .form-input:-webkit-autofill,
    .form-input:-webkit-autofill:hover,
    .form-input:-webkit-autofill:focus {
      -webkit-text-fill-color: #FFFFFF;
      -webkit-box-shadow: 0 0 0 1000px #0B0A0F inset;
      transition: background-color 5000s ease-in-out 0s;
    }
    .btn-submit {
      width: 100%;
      background: #FFD700;
      color: #000;
      font-weight: 800;
      font-size: 14px;
      padding: 14px;
      border: none;
      border-radius: 999px;
      cursor: pointer;
      margin-top: 10px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 18px rgba(255, 215, 0, 0.3);
    }
    .btn-submit:hover {
      background: #FFE566;
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(255, 215, 0, 0.45);
    }
    .default-creds {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 11.5px;
      color: #888;
      text-align: center;
      line-height: 1.6;
    }
    .default-creds code {
      color: #FFD700;
      background: rgba(255, 215, 0, 0.08);
      padding: 2px 6px;
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <div class="ambient-glow"></div>

  <div class="login-container">
    <div class="login-header">
      <div class="brand-mark">
        <img src="/images/group-c-logo.svg" alt="Cloutgency">
      </div>
      <h1 class="title">CLOUT<span>GENCY</span></h1>
      <p class="subtitle">Secure Studio Command Center</p>
    </div>

    <% if (error) { %>
      <div class="alert-error">
        <span>⚠️</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/admin/login">
      <input type="hidden" name="returnUrl" value="<%= returnUrl %>">

      <div class="form-group">
        <label class="form-label" for="admin-email">Authorized Email</label>
        <input id="admin-email" type="email" name="email" class="form-input" placeholder="Enter your email" autocomplete="email" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label" for="admin-password">Password</label>
        <input id="admin-password" type="password" name="password" class="form-input" placeholder="••••••••" autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn-submit">Authenticate Studio Access →</button>
    </form>


  </div>
</body>
</html>
