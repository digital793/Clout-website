  <script>
    const COLKEY = '${collectionKey}';
    const IS_WORKS = ${collectionType === 'works'};
    const IS_BLOGS = ${collectionType === 'blogs'};
    const IS_TEAM = ${collectionType === 'team'};
    const modal = document.getElementById('itemModal');
    const form = document.getElementById('itemForm');

    document.getElementById('btnOpenNewItem').addEventListener('click', () => {
      form.reset(); clearUpload();
      document.getElementById('itemId').value = '';
      document.getElementById('itemImageUrl').value = '';
      const altImageUrlInput = document.getElementById('itemAltImageUrl');
      if (altImageUrlInput) altImageUrlInput.value = '';
      const imageUrlInput = document.getElementById('itemImageUrlInput');
      if (imageUrlInput) imageUrlInput.value = '';
      const videoUrlInput = document.getElementById('itemVideoUrl');
      if (videoUrlInput) videoUrlInput.value = '';
      const activeCheckbox = document.getElementById('itemIsActive');
      if (activeCheckbox) activeCheckbox.checked = true;
      const publishedCheckbox = document.getElementById('itemIsPublished');
      if (publishedCheckbox) publishedCheckbox.checked = true;
      const publishedAtInput = document.getElementById('itemPublishedAt');
      if (publishedAtInput) {
        const today = new Date();
        const localDate = new Date(today.getTime() - today.getTimezoneOffset() * 60000);
        publishedAtInput.value = localDate.toISOString().slice(0, 10);
      }
      if (IS_TEAM) {
        clearTeamUpload('front');
        clearTeamUpload('back');
        const roleInput = document.getElementById('itemRole');
        if (roleInput) roleInput.value = '';
        const deptInput = document.getElementById('itemDepartment');
        if (deptInput) deptInput.value = 'managers';
        const altNameInput = document.getElementById('itemAltName');
        if (altNameInput) altNameInput.value = '';
      }
      if (IS_BLOGS) {
        document.getElementById('itemReadTime').dataset.edited = '';
        window.loadBlogEditorContent('');
        document.getElementById('blogRichEditor').hidden = false;
        document.getElementById('blogEditorPreview').hidden = true;
        document.getElementById('btnPreviewBlog').textContent = 'Preview';
        document.getElementById('btnPreviewBlog').setAttribute('aria-pressed', 'false');
        const sp = document.getElementById('slugPreviewText');
        if (sp) sp.textContent = 'your-article-url';
        const ts = document.getElementById('blogTopbarStats');
        if (ts) ts.textContent = '0 words · 1 min read';
      }
      const slugInput = document.getElementById('itemSlug');
      if (slugInput) slugInput.dataset.edited = '';
      document.getElementById('modalHeading').textContent = 'Add New ${config.title}';
      modal.classList.add('show');
      document.body.classList.add('modal-open');
      if (IS_BLOGS) document.body.classList.add('blog-studio-active');
    });

    function openEditModal(itemData) {
      const item = typeof itemData === 'string' ? JSON.parse(itemData) : itemData;
      form.reset(); clearUpload();
      document.getElementById('itemId').value = item.id || '';
      document.getElementById('itemTitle').value = item.title || item.name || '';
      const categoryInput = document.getElementById('itemCategory');
      if (categoryInput) categoryInput.value = item.category || item.role || item.author || '';
      const linkInput = document.getElementById('itemLink');
      if (linkInput) linkInput.value = item.link || (IS_WORKS ? '' : item.videoUrl || item.linkedinUrl || item.caseStudyUrl) || '';
      const descriptionInput = document.getElementById('itemDesc');
      if (descriptionInput) descriptionInput.value = item.shortDesc || item.summary || item.excerpt || item.bio || '';
      const img = item.image || item.coverImage || item.photo || '';
      document.getElementById('itemImageUrl').value = img;
      const imageUrlInput = document.getElementById('itemImageUrlInput');
      if (imageUrlInput) imageUrlInput.value = img;
      if (IS_WORKS) {
        document.getElementById('itemClient').value = item.client || '';
        document.getElementById('itemHighlight').value = item.highlightText || '';
        document.getElementById('itemTags').value = Array.isArray(item.tags) ? item.tags.join('\\n') : '';
        document.getElementById('itemVideoUrl').value = item.videoUrl || '';
        document.getElementById('itemShowOnHome').checked = Boolean(item.showOnHome);
        document.getElementById('itemIsActive').checked = item.isActive !== false;
        if (img) showWorkImagePreview(img, img.split('/').pop());
        if (item.videoUrl) showWorkVideoPreview(item.videoUrl, item.videoUrl.split('/').pop());
      } else if (IS_TEAM) {
        document.getElementById('itemTitle').value = item.name || item.title || '';
        const roleInput = document.getElementById('itemRole');
        if (roleInput) roleInput.value = item.role || item.category || '';
        const deptInput = document.getElementById('itemDepartment');
        if (deptInput) deptInput.value = item.department || 'managers';
        
        const frontImg = item.image || '';
        document.getElementById('itemImageUrl').value = frontImg;
        const frontUrlInput = document.getElementById('teamFrontUrlInput');
        if (frontUrlInput) frontUrlInput.value = frontImg;
        if (frontImg) tryPreviewTeamUrl('front', frontImg);

        const backImg = item.altImage || item.image || '';
        const altImgHidden = document.getElementById('itemAltImageUrl');
        if (altImgHidden) altImgHidden.value = backImg;
        const backUrlInput = document.getElementById('teamBackUrlInput');
        if (backUrlInput) backUrlInput.value = backImg;
        if (backImg) tryPreviewTeamUrl('back', backImg);

        const altNameInput = document.getElementById('itemAltName');
        if (altNameInput) altNameInput.value = item.altName || '';
        const descInput = document.getElementById('itemDesc');
        if (descInput) descInput.value = item.bio || item.shortDesc || item.role || '';
        const linkInput = document.getElementById('itemLink');
        if (linkInput) linkInput.value = item.linkedinUrl || item.link || '';
        const activeInput = document.getElementById('itemIsActive');
        if (activeInput) activeInput.checked = item.isActive !== false;
      } else if (IS_BLOGS) {
        document.getElementById('itemSlug').value = item.slug || '';
        document.getElementById('itemSlug').dataset.edited = 'true';
        const sp = document.getElementById('slugPreviewText');
        if (sp) sp.textContent = item.slug || 'your-article-url';
        document.getElementById('itemAuthor').value = item.author || '';
        document.getElementById('itemTags').value = Array.isArray(item.tags) ? item.tags.join('\\n') : '';
        document.getElementById('itemPublishedAt').value = item.publishedAt || '';
        document.getElementById('itemReadTime').value = item.readTime || '';
        document.getElementById('itemReadTime').dataset.edited = item.readTime ? 'true' : '';
        document.getElementById('itemExcerpt').value = item.excerpt || '';
        window.loadBlogEditorContent(item.content || '');
        document.getElementById('blogRichEditor').hidden = false;
        document.getElementById('blogEditorPreview').hidden = true;
        document.getElementById('btnPreviewBlog').textContent = 'Preview';
        document.getElementById('btnPreviewBlog').setAttribute('aria-pressed', 'false');
        document.getElementById('itemIsPublished').checked = item.isPublished !== false;
        if (img) tryPreviewUrl(img);
        updateBlogEditorStats();
      } else if (img) {
        tryPreviewUrl(img);
      }
      document.getElementById('modalHeading').textContent = 'Edit: ' + (item.title || item.name || 'Entry');
      modal.classList.add('show');
      document.body.classList.add('modal-open');
      if (IS_BLOGS) document.body.classList.add('blog-studio-active');
    }

    function closeModal() {
      modal.classList.remove('show');
      document.body.classList.remove('modal-open');
      document.body.classList.remove('blog-studio-active');
    }
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    window.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal.classList.contains('show')) closeModal();
    });

    if (IS_WORKS) {
      ['image', 'video'].forEach(type => {
        const zone = document.getElementById('work' + (type === 'image' ? 'Image' : 'Video') + 'UploadZone');
        if (!zone) return;
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
        zone.addEventListener('drop', e => {
          e.preventDefault();
          zone.classList.remove('drag-over');
          if (e.dataTransfer.files[0]) uploadWorkFile(type, e.dataTransfer.files[0]);
        });
      });
    } else if (IS_TEAM) {
      ['front', 'back'].forEach(type => {
        const zone = document.getElementById(type === 'front' ? 'teamFrontUploadZone' : 'teamBackUploadZone');
        if (!zone) return;
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
        zone.addEventListener('drop', e => {
          e.preventDefault();
          zone.classList.remove('drag-over');
          if (e.dataTransfer.files[0]) uploadTeamFile(type, e.dataTransfer.files[0]);
        });
      });
    } else {
      const zone = document.getElementById('uploadZone');
      if (zone) {
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
        zone.addEventListener('drop', e => {
          e.preventDefault();
          zone.classList.remove('drag-over');
          const file = e.dataTransfer.files[0];
          if (!file) return;
          if (IS_BLOGS) uploadBlogFile(file);
          else uploadFile(file);
        });
      }
    }

    function handleFileSelect(input) {
      if (!input.files[0]) return;
      if (IS_BLOGS) uploadBlogFile(input.files[0]);
      else uploadFile(input.files[0]);
    }
    function handleWorkFileSelect(type, input) {
      if (input.files[0]) uploadWorkFile(type, input.files[0]);
    }
    function handleTeamFileSelect(type, input) {
      if (input.files[0]) uploadTeamFile(type, input.files[0]);
    }

    async function uploadTeamFile(type, file) {
      const isFront = type === 'front';
      const input = document.getElementById(isFront ? 'teamFrontFileInput' : 'teamBackFileInput');
      if (input) input.disabled = true;
      const fd = new FormData();
      fd.append('file', file);
      try {
        const res = await fetch('/api/admin/media/upload', { method: 'POST', body: fd });
        const r = await res.json();
        if (!res.ok || !r.success) throw new Error(r.error || 'Upload failed');
        const hidden = document.getElementById(isFront ? 'itemImageUrl' : 'itemAltImageUrl');
        if (hidden) hidden.value = r.url;
        const urlInput = document.getElementById(isFront ? 'teamFrontUrlInput' : 'teamBackUrlInput');
        if (urlInput) urlInput.value = r.url;
        showTeamPreview(type, r.url, file.name);
        showToast('Uploaded ' + (isFront ? 'front' : 'flip') + ' photo: ' + r.filename);
      } catch (err) {
        showToast('Upload error: ' + err.message, true);
      } finally {
        if (input) { input.disabled = false; input.value = ''; }
      }
    }

    function showTeamPreview(type, url, name) {
      const isFront = type === 'front';
      const img = document.getElementById(isFront ? 'teamFrontPreviewImg' : 'teamBackPreviewImg');
      const fileName = document.getElementById(isFront ? 'teamFrontFileName' : 'teamBackFileName');
      const preview = document.getElementById(isFront ? 'teamFrontPreview' : 'teamBackPreview');
      if (img) img.src = url;
      if (fileName) fileName.textContent = name || url.split('/').pop();
      if (preview) preview.classList.add('has-image');
    }

    function tryPreviewTeamUrl(type, url) {
      if (/\.(jpg|jpeg|png|webp|gif|svg)$/i.test(url)) {
        showTeamPreview(type, url, url.split('/').pop());
      }
    }

    function clearTeamUpload(type) {
      const isFront = type === 'front';
      const hidden = document.getElementById(isFront ? 'itemImageUrl' : 'itemAltImageUrl');
      if (hidden) hidden.value = '';
      const urlInput = document.getElementById(isFront ? 'teamFrontUrlInput' : 'teamBackUrlInput');
      if (urlInput) urlInput.value = '';
      const preview = document.getElementById(isFront ? 'teamFrontPreview' : 'teamBackPreview');
      if (preview) preview.classList.remove('has-image');
      const fileInput = document.getElementById(isFront ? 'teamFrontFileInput' : 'teamBackFileInput');
      if (fileInput) fileInput.value = '';
    }

    async function uploadWorkFile(type, file) {
      const formData = new FormData();
      formData.append('file', file);
      const inputId = type === 'image' ? 'workImageFileInput' : 'workVideoFileInput';
      const input = document.getElementById(inputId);
      input.disabled = true;
      try {
        const response = await fetch('/api/admin/works/upload/' + type, { method: 'POST', body: formData });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Upload failed.');
        if (type === 'image') {
          document.getElementById('itemImageUrl').value = result.url;
          showWorkImagePreview(result.url, file.name);
        } else {
          document.getElementById('itemVideoUrl').value = result.url;
          showWorkVideoPreview(result.url, file.name);
        }
        showToast('Uploaded: ' + result.filename);
      } catch (error) {
        showToast('Upload error: ' + error.message, true);
      } finally {
        input.disabled = false;
        input.value = '';
      }
    }

    async function uploadFile(file) {
      const prog = document.getElementById('uploadProgress');
      const bar = document.getElementById('uploadProgressBar');
      prog.classList.add('active'); bar.style.width = '20%';
      const fd = new FormData(); fd.append('file', file);
      try {
        bar.style.width = '65%';
        const res = await fetch('/api/admin/media/upload', { method:'POST', body:fd });
        bar.style.width = '95%';
        const r = await res.json();
        if (r.success) {
          bar.style.width = '100%';
          document.getElementById('itemImageUrl').value = r.url;
          document.getElementById('itemImageUrlInput').value = r.url;
          showPreview(r.url, file.name);
          showToast('Uploaded: ' + r.filename);
        } else { showToast(r.error || 'Upload failed', true); }
      } catch(err) { showToast('Upload error: ' + err.message, true); }
      finally { setTimeout(() => { prog.classList.remove('active'); bar.style.width='0'; }, 900); }
    }

    async function uploadBlogFile(file) {
      const input = document.getElementById('imageFileInput');
      input.disabled = true;
      const formData = new FormData();
      formData.append('file', file);
      try {
        const response = await fetch('/api/admin/blogs/upload/image', { method: 'POST', body: formData });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Cover image upload failed.');
        document.getElementById('itemImageUrl').value = result.url;
        document.getElementById('itemImageUrlInput').value = result.url;
        showPreview(result.url, file.name);
        showToast('Uploaded: ' + result.filename);
      } catch (error) {
        showToast('Upload error: ' + error.message, true);
      } finally {
        input.disabled = false;
        input.value = '';
      }
    }

    function showPreview(url, name) {
      document.getElementById('uploadPreviewImg').src = url;
      document.getElementById('uploadFileName').textContent = name || url.split('/').pop();
      document.getElementById('uploadPreview').classList.add('has-image');
    }
    function showWorkImagePreview(url, name) {
      document.getElementById('workImagePreviewImg').src = url;
      document.getElementById('workImageFileName').textContent = name || url.split('/').pop();
      document.getElementById('workImagePreview').classList.add('has-image');
    }
    function showWorkVideoPreview(url, name) {
      const preview = document.getElementById('workVideoPreview');
      const player = document.getElementById('workVideoPreviewPlayer');
      player.src = url;
      preview.style.display = 'block';
      document.getElementById('workVideoFileName').textContent = name || url.split('/').pop();
      document.getElementById('workVideoEmpty').style.display = 'none';
    }
    function tryPreviewUrl(url) {
      if (/\.(jpg|jpeg|png|webp|gif|svg)$/i.test(url)) showPreview(url, url.split('/').pop());
    }
    function clearUpload() {
      const imageUrl = document.getElementById('itemImageUrl');
      if (imageUrl) imageUrl.value = '';
      const altImageUrl = document.getElementById('itemAltImageUrl');
      if (altImageUrl) altImageUrl.value = '';
      const imageUrlInput = document.getElementById('itemImageUrlInput');
      if (imageUrlInput) imageUrlInput.value = '';
      const uploadPreview = document.getElementById('uploadPreview');
      if (uploadPreview) uploadPreview.classList.remove('has-image');
      const imageInput = document.getElementById('imageFileInput');
      if (imageInput) imageInput.value = '';
      const workImageInput = document.getElementById('workImageFileInput');
      if (workImageInput) workImageInput.value = '';
      const workVideoInput = document.getElementById('workVideoFileInput');
      if (workVideoInput) workVideoInput.value = '';
      const workImagePreview = document.getElementById('workImagePreview');
      if (workImagePreview) workImagePreview.classList.remove('has-image');
      const workVideoPreview = document.getElementById('workVideoPreview');
      if (workVideoPreview) workVideoPreview.style.display = 'none';
      const workVideoPlayer = document.getElementById('workVideoPreviewPlayer');
      if (workVideoPlayer) workVideoPlayer.removeAttribute('src');
      const workVideoEmpty = document.getElementById('workVideoEmpty');
      if (workVideoEmpty) workVideoEmpty.style.display = 'block';
      if (IS_TEAM) {
        clearTeamUpload('front');
        clearTeamUpload('back');
      }
    }

    if (IS_BLOGS) {
      document.getElementById('itemTitle').addEventListener('input', event => {
        const slugInput = document.getElementById('itemSlug');
        if (!slugInput.dataset.edited) {
          slugInput.value = event.target.value.toLowerCase()
            .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        }
        const sp = document.getElementById('slugPreviewText');
        if (sp) sp.textContent = slugInput.value || 'your-article-url';
      });
      document.getElementById('itemSlug').addEventListener('input', event => {
        event.target.dataset.edited = 'true';
        const sp = document.getElementById('slugPreviewText');
        if (sp) sp.textContent = event.target.value || 'your-article-url';
      });

      const contentInput = document.getElementById('itemContent');
      const richEditor = document.getElementById('blogRichEditor');
      const preview = document.getElementById('blogEditorPreview');
      const previewButton = document.getElementById('btnPreviewBlog');
      const wordCount = document.getElementById('blogWordCount');
      const readTimeInput = document.getElementById('itemReadTime');
      let savedEditorRange = null;

      function escapeBlogHtml(value) {
        return value.replace(/[&<>"']/g, character => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[character]);
      }

      function safeBlogLink(value) {
        return /^(https?:\\/\\/|\\/(?!\\/)|#|mailto:)/i.test(value);
      }

      function renderBlogMarkdown(markdown) {
        const blocks = markdown.trim().split(/\\r?\\n\\s*\\r?\\n/).filter(Boolean);
        const renderInline = value => {
          let escaped = escapeBlogHtml(value);
          escaped = escaped.replace(/!\\[([^\\]]*)\\]\\(([^)\\s]+)\\)/g, (match, alt, url) =>
            /^\\/images\\/[a-z0-9_./%-]+$/i.test(url)
              ? '<img src="' + url + '" alt="' + alt + '">'
              : match
          );
          escaped = escaped.replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, (match, label, url) =>
            safeBlogLink(url) ? '<a href="' + url + '">' + label + '</a>' : label
          );
          return escaped
            .replace(/\\x60([^\\x60]+)\\x60/g, '<code>$1</code>')
            .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')
            .replace(/_([^_]+)_/g, '<em>$1</em>');
        };

        return blocks.map(block => {
          const lines = block.split(/\\r?\\n/);
          const heading = lines.length === 1 && lines[0].match(/^(#{2,4})\\s+(.+)$/);
          if (heading) {
            const level = heading[1].length;
            return '<h' + level + '>' + renderInline(heading[2]) + '</h' + level + '>';
          }
          if (lines.every(line => /^\\s*[-*]\\s+/.test(line))) {
            return '<ul>' + lines.map(line => '<li>' + renderInline(line.replace(/^\\s*[-*]\\s+/, '')) + '</li>').join('') + '</ul>';
          }
          if (lines.every(line => /^\\s*\\d+[.)]\\s+/.test(line))) {
            return '<ol>' + lines.map(line => '<li>' + renderInline(line.replace(/^\\s*\\d+[.)]\\s+/, '')) + '</li>').join('') + '</ol>';
          }
          if (lines.every(line => /^\\s*&gt;\\s?/.test(escapeBlogHtml(line)))) {
            return '<blockquote>' + lines.map(line => renderInline(line.replace(/^\\s*>\\s?/, ''))).join('<br>') + '</blockquote>';
          }
          return '<p>' + lines.map(renderInline).join('<br>') + '</p>';
        }).join('');
      }

      function serializeEditorNode(node) {
        if (node.nodeType === Node.TEXT_NODE) return node.nodeValue;
        if (node.nodeType !== Node.ELEMENT_NODE) return '';

        const tag = node.tagName.toLowerCase();
        const children = Array.from(node.childNodes).map(serializeEditorNode).join('');
        if (tag === 'img') {
          const src = node.getAttribute('src') || '';
          const alt = (node.getAttribute('alt') || '').replace(/[\]\\]/g, '\\$&');
          return /^\\/images\\/[a-z0-9_./%-]+$/i.test(src) ? '![' + alt + '](' + src + ')' : '';
        }
        if (tag === 'br') return '\\n';
        if (tag === 'strong' || tag === 'b') return '**' + children + '**';
        if (tag === 'em' || tag === 'i') return '_' + children + '_';
        if (tag === 'code') return String.fromCharCode(96) + children + String.fromCharCode(96);
        if (tag === 'a') {
          const href = node.getAttribute('href') || '';
          return safeBlogLink(href) ? '[' + children + '](' + href + ')' : children;
        }
        if (/^h[2-4]$/.test(tag)) return '#'.repeat(Number(tag.slice(1))) + ' ' + children.trim();
        if (tag === 'li') return children.trim();
        if (tag === 'ul' || tag === 'ol') {
          const items = Array.from(node.children).filter(child => child.tagName.toLowerCase() === 'li');
          return items.map((item, index) =>
            (tag === 'ol' ? (index + 1) + '. ' : '- ') + serializeEditorNode(item).trim()
          ).join('\\n');
        }
        if (tag === 'blockquote') {
          return children.trim().split(/\\r?\\n/).map(line => '> ' + line).join('\\n');
        }
        if (tag === 'p' || tag === 'div') return children.trim();
        return children;
      }

      function serializeEditor() {
        return Array.from(richEditor.childNodes)
          .map(serializeEditorNode)
          .filter(Boolean)
          .join('\\n\\n')
          .replace(/\\n{3,}/g, '\\n\\n')
          .trim();
      }

      function syncEditorContent() {
        contentInput.value = serializeEditor();
      }
      window.loadBlogEditorContent = markdown => {
        contentInput.value = markdown || '';
        richEditor.innerHTML = renderBlogMarkdown(contentInput.value);
        updateBlogEditorStats();
      };
      window.getBlogEditorContent = () => {
        syncEditorContent();
        return contentInput.value;
      };

      function rememberEditorSelection() {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return;
        const range = selection.getRangeAt(0);
        if (richEditor.contains(range.commonAncestorContainer)) {
          savedEditorRange = range.cloneRange();
        }
      }

      function restoreEditorSelection() {
        richEditor.focus();
        if (!savedEditorRange) return;
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(savedEditorRange);
      }

      function insertEditorHtml(html) {
        restoreEditorSelection();
        document.execCommand('insertHTML', false, html);
        rememberEditorSelection();
        syncEditorContent();
        updateBlogEditorStats();
      }

      function updateBlogEditorStats() {
        syncEditorContent();
        const words = contentInput.value.trim().split(/\s+/).filter(Boolean).length;
        const minutes = Math.max(1, Math.ceil(words / 200));
        wordCount.textContent = words + ' words · about ' + minutes + ' min read';
        const topbarStats = document.getElementById('blogTopbarStats');
        if (topbarStats) topbarStats.textContent = words + ' words · ' + minutes + ' min read';
        if (!readTimeInput.dataset.edited) readTimeInput.value = minutes + ' min read';
        if (!preview.hidden) preview.innerHTML = renderBlogMarkdown(contentInput.value) || '<p>Your article preview will appear here.</p>';
      }

      const toolbarHtml = {
        '## Heading\\n': '<h2>Heading</h2><p><br></p>',
        '### Subheading\\n': '<h3>Subheading</h3><p><br></p>',
        '**Bold text**': '<strong>Bold text</strong>',
        '_Italic text_': '<em>Italic text</em>',
        '- List item\\n': '<ul><li>List item</li></ul><p><br></p>',
        '> Quote\\n': '<blockquote>Quote</blockquote><p><br></p>'
      };
      document.querySelectorAll('[data-markdown]').forEach(button => {
        button.addEventListener('mousedown', rememberEditorSelection);
        button.addEventListener('click', () => {
          insertEditorHtml(toolbarHtml[button.dataset.markdown] || '');
        });
      });

      richEditor.addEventListener('input', updateBlogEditorStats);
      richEditor.addEventListener('keyup', rememberEditorSelection);
      richEditor.addEventListener('mouseup', rememberEditorSelection);
      richEditor.addEventListener('focus', rememberEditorSelection);
      readTimeInput.addEventListener('input', () => { readTimeInput.dataset.edited = 'true'; });
      previewButton.addEventListener('click', () => {
        const showPreview = preview.hidden;
        preview.hidden = !showPreview;
        richEditor.hidden = showPreview;
        previewButton.setAttribute('aria-pressed', String(showPreview));
        previewButton.textContent = showPreview ? 'Write' : 'Preview';
        if (showPreview) preview.innerHTML = renderBlogMarkdown(contentInput.value) || '<p>Your article preview will appear here.</p>';
        else richEditor.focus();
      });

      document.getElementById('btnInsertBlogImage').addEventListener('mousedown', rememberEditorSelection);
      document.getElementById('btnInsertBlogImage').addEventListener('click', () => {
        document.getElementById('blogInlineImageInput').click();
      });
      document.getElementById('blogInlineImageInput').addEventListener('change', async event => {
        const file = event.target.files[0];
        if (!file) return;
        const formData = new FormData();
        formData.append('file', file);
        const uploadInput = document.getElementById('blogInlineImageInput');
        uploadInput.disabled = true;
        try {
          const response = await fetch('/api/admin/blogs/upload/inline-image', { method: 'POST', body: formData });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.error || 'Article image upload failed.');
          const imageAlt = file.name.replace(/\\.[^.]+$/, '').replace(/[^a-zA-Z0-9 _-]/g, '');
          insertEditorHtml('<p><img src="' + escapeBlogHtml(result.url) + '" alt="' + escapeBlogHtml(imageAlt) + '"></p><p><br></p>');
          showToast('Article image uploaded and inserted.');
        } catch (error) {
          showToast('Image upload error: ' + error.message, true);
        } finally {
          uploadInput.disabled = false;
          uploadInput.value = '';
        }
      });
      richEditor.innerHTML = renderBlogMarkdown(contentInput.value);
      updateBlogEditorStats();
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const btn = document.getElementById('saveBtn');
      btn.disabled = true; btn.textContent = 'Saving...';
      const payload = IS_WORKS ? {
        id: document.getElementById('itemId').value || undefined,
        client: document.getElementById('itemClient').value,
        title: document.getElementById('itemTitle').value,
        highlightText: document.getElementById('itemHighlight').value,
        category: document.getElementById('itemCategory').value,
        tags: document.getElementById('itemTags').value.split(/\\r?\\n/).map(tag => tag.trim()).filter(Boolean),
        image: document.getElementById('itemImageUrl').value,
        videoUrl: document.getElementById('itemVideoUrl').value,
        link: document.getElementById('itemLink').value,
        shortDesc: document.getElementById('itemDesc').value,
        showOnHome: document.getElementById('itemShowOnHome').checked,
        isActive: document.getElementById('itemIsActive').checked
      } : IS_BLOGS ? {
        id: document.getElementById('itemId').value || undefined,
        title: document.getElementById('itemTitle').value,
        slug: document.getElementById('itemSlug').value,
        author: document.getElementById('itemAuthor').value,
        tags: document.getElementById('itemTags').value.split(/\\r?\\n/).map(tag => tag.trim()).filter(Boolean),
        publishedAt: document.getElementById('itemPublishedAt').value,
        readTime: document.getElementById('itemReadTime').value,
        excerpt: document.getElementById('itemExcerpt').value,
        content: window.getBlogEditorContent(),
        coverImage: document.getElementById('itemImageUrl').value,
        isPublished: document.getElementById('itemIsPublished').checked
      } : IS_TEAM ? {
        id: document.getElementById('itemId').value || undefined,
        name: document.getElementById('itemTitle').value,
        title: document.getElementById('itemTitle').value,
        role: document.getElementById('itemRole').value,
        category: document.getElementById('itemRole').value,
        department: document.getElementById('itemDepartment').value,
        image: document.getElementById('itemImageUrl').value,
        altImage: (document.getElementById('itemAltImageUrl') && document.getElementById('itemAltImageUrl').value) || document.getElementById('itemImageUrl').value,
        altName: (document.getElementById('itemAltName') && document.getElementById('itemAltName').value) || document.getElementById('itemTitle').value,
        bio: document.getElementById('itemDesc').value,
        shortDesc: document.getElementById('itemDesc').value,
        linkedinUrl: (document.getElementById('itemLink') && document.getElementById('itemLink').value) || '',
        link: (document.getElementById('itemLink') && document.getElementById('itemLink').value) || '',
        isActive: document.getElementById('itemIsActive') ? document.getElementById('itemIsActive').checked : true
      } : {
        id: document.getElementById('itemId').value || undefined,
        title: document.getElementById('itemTitle').value,
        category: document.getElementById('itemCategory').value,
        image: document.getElementById('itemImageUrl').value,
        link: document.getElementById('itemLink').value,
        shortDesc: document.getElementById('itemDesc').value,
      };
      if (IS_TEAM && !payload.image) {
        showToast('Please upload or provide a default front photo for the team member.', true);
        btn.disabled = false;
        btn.textContent = 'Save Entry ✦';
        return;
      }
      if (IS_BLOGS && !payload.content.trim()) {
        showToast('Add article content before saving.', true);
        btn.disabled = false;
        btn.textContent = 'Save Entry ✦';
        return;
      }
      if (!payload.id) delete payload.id;
      try {
        const res = await fetch('/api/admin/collections/' + COLKEY, {
          method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)
        });
        const r = await res.json();
        if (r.success) { showToast('Entry saved!'); setTimeout(() => location.reload(), 600); }
        else { showToast(r.error || 'Save failed', true); }
      } catch(err) { showToast('Error: ' + err.message, true); }
      finally { btn.disabled=false; btn.textContent='Save Entry ✦'; }
    });

    async function deleteItem(colKey, id) {
      if (!confirm('Delete this entry permanently?')) return;
      try {
        const res = await fetch('/api/admin/collections/' + colKey + '/' + id, { method:'DELETE' });
        const r = await res.json();
        if (r.success) { showToast('Entry removed'); document.getElementById('card_' + id)?.remove(); }
        else showToast(r.error, true);
      } catch(err) { showToast('Delete error: ' + err.message, true); }
    }
  </script>
