<%- include('layout', {
  body: `
  <style>
    .collections-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }
    .items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }
    .item-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition);
    }
    .item-card:hover {
      border-color: var(--border-gold);
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }
    .item-card-media {
      height: 155px;
      background: #0a090e;
      position: relative;
      overflow: hidden;
    }
    .item-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .no-img {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--text-dim);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .item-card-body {
      padding: 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .item-badge {
      font-size: 10px;
      font-weight: 800;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 5px;
    }
    .item-title {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
    }
    .item-desc {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 14px;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .item-actions {
      display: flex;
      gap: 8px;
      padding-top: 12px;
      border-top: 1px solid var(--border-subtle);
    }
    .upload-zone {
      border: 2px dashed var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 18px;
      text-align: center;
      cursor: pointer;
      transition: var(--transition);
      position: relative;
    }
    .upload-zone:hover, .upload-zone.drag-over {
      border-color: var(--gold);
      background: rgba(255,215,0,0.04);
    }
    .upload-zone input[type="file"] {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }
    .upload-zone-label { font-size: 12px; color: var(--text-muted); font-weight: 600; }
    .upload-zone-label span { color: var(--gold); }
    .upload-preview {
      margin-top: 10px;
      display: none;
      align-items: center;
      gap: 10px;
    }
    .upload-preview.has-image { display: flex; }
    .upload-preview img { width: 52px; height: 52px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-gold); }
    .upload-preview .file-name { font-size: 11px; color: var(--gold); font-weight: 600; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .or-divider { display: flex; align-items: center; gap: 10px; margin: 10px 0; font-size: 10px; color: var(--text-dim); font-weight: 700; }
    .or-divider::before, .or-divider::after { content: ''; flex: 1; height: 1px; background: var(--border-subtle); }
    .upload-progress { height: 3px; background: var(--border-subtle); border-radius: 99px; margin-top: 8px; overflow: hidden; display: none; }
    .upload-progress-bar { height: 100%; width: 0; background: var(--gold); border-radius: 99px; transition: width 0.3s ease; }
    .upload-progress.active { display: block; }
    .blog-editor-heading, .blog-editor-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .blog-editor-hint, .blog-editor-footer { color: var(--text-dim); font-size: 11px; }
    .blog-editor-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 8px;
      background: rgba(6, 5, 8, 0.8);
      border: 1px solid var(--border-subtle);
      border-bottom: 0;
      border-radius: 8px 8px 0 0;
    }
    .blog-editor-toolbar button {
      min-width: 34px;
      padding: 7px 10px;
      border: 1px solid var(--border-subtle);
      border-radius: 5px;
      background: var(--bg-card);
      color: var(--text-muted);
      font-size: 11px;
      cursor: pointer;
    }
    .blog-editor-toolbar button:hover, .blog-editor-toolbar button[aria-pressed="true"] {
      border-color: var(--gold);
      color: var(--gold);
    }
    .blog-editor-canvas {
      min-height: 390px;
      max-height: 60vh;
      overflow-y: auto;
      padding: 14px 16px;
      border: 1px solid var(--border-subtle);
      border-radius: 0 0 8px 8px;
      background: rgba(6, 5, 8, 0.8);
      color: #eee;
      font-size: 13px;
      line-height: 1.75;
      overflow-wrap: anywhere;
      outline: none;
    }
    .blog-editor-canvas:focus {
      border-color: var(--gold);
    }
    .blog-editor-canvas:empty::before {
      content: attr(data-placeholder);
      color: var(--text-dim);
      pointer-events: none;
    }
    .blog-editor-canvas h2, .blog-editor-canvas h3, .blog-editor-canvas h4,
    .blog-editor-preview h2, .blog-editor-preview h3 { color: #fff; margin: 1.5em 0 0.5em; }
    .blog-editor-canvas p, .blog-editor-preview p { margin: 0 0 1em; }
    .blog-editor-canvas blockquote, .blog-editor-preview blockquote {
      margin: 1em 0; padding-left: 14px; border-left: 3px solid var(--gold); color: var(--text-muted);
    }
    .blog-editor-canvas img, .blog-editor-preview img {
      display: block; max-width: 100%; height: auto; margin: 12px 0; border-radius: 8px;
    }
    .blog-editor-canvas a, .blog-editor-preview a { color: var(--gold); }
    .blog-editor-preview {
      min-height: 390px;
      padding: 18px;
      border: 1px solid var(--border-subtle);
      border-radius: 0 0 8px 8px;
      background: rgba(6, 5, 8, 0.8);
      color: #eee;
      line-height: 1.75;
      overflow-wrap: anywhere;
    }
    .blog-editor-source {
      display: none;
    }
    .blog-editor-footer { margin-top: 8px; }
    .blog-editor-footer span:last-child { text-align: right; }
    @media (max-width: 640px) {
      .blog-editor-footer { align-items: flex-start; flex-direction: column; }
      .blog-editor-footer span:last-child { text-align: left; }
    }

    /* ─── Full Display Studio for Blogs ───────────────────────────── */
    .modal-backdrop.blog-fullscreen-backdrop {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      padding: 0 !important;
      background: #09080d !important;
      backdrop-filter: none !important;
      align-items: stretch !important;
      justify-content: stretch !important;
      z-index: 99999 !important;
    }
    .modal-box.blog-fullscreen-modal {
      width: 100vw !important;
      height: 100vh !important;
      max-width: 100vw !important;
      max-height: 100vh !important;
      border-radius: 0 !important;
      border: none !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      background: #0c0b11 !important;
      box-shadow: none !important;
      overflow: hidden !important;
    }
    .blog-studio-topbar {
      height: 60px;
      min-height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      background: #111017;
      border-bottom: 1px solid var(--border-subtle);
      z-index: 10;
      gap: 16px;
    }
    .blog-studio-topbar-left {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }
    .btn-studio-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .btn-studio-back:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.2);
    }
    .blog-studio-divider {
      width: 1px;
      height: 24px;
      background: var(--border-subtle);
    }
    .blog-studio-heading-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }
    .blog-studio-badge {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--gold);
      background: rgba(255, 215, 0, 0.1);
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid rgba(255, 215, 0, 0.25);
      white-space: nowrap;
    }
    .blog-studio-title {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .blog-studio-topbar-right {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }
    .blog-studio-stat-pill {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-dim);
      background: rgba(255, 255, 255, 0.04);
      padding: 6px 12px;
      border-radius: 20px;
      border: 1px solid var(--border-subtle);
      white-space: nowrap;
    }
    .blog-studio-toggle-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      cursor: pointer;
      padding: 6px 12px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      user-select: none;
    }
    .blog-studio-toggle-label input {
      accent-color: var(--gold);
      cursor: pointer;
    }
    .btn-studio-close {
      background: none;
      border: none;
      color: var(--text-dim);
      font-size: 18px;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-studio-close:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
    }
    .blog-studio-form {
      display: flex;
      flex: 1;
      height: calc(100vh - 60px);
      overflow: hidden;
    }
    .blog-studio-body {
      display: grid;
      grid-template-columns: 1fr 390px;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    .blog-studio-main {
      height: 100%;
      overflow-y: auto;
      padding: 32px 48px 60px;
      background: #0c0b11;
      display: flex;
      flex-direction: column;
    }
    .blog-title-input {
      width: 100%;
      background: #111016;
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      color: #fff;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.35;
      padding: 14px 18px;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      font-family: inherit;
    }
    .blog-title-input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 15px var(--gold-glow);
    }
    .blog-title-input::placeholder {
      color: rgba(255, 255, 255, 0.25);
      font-weight: 700;
    }
    .blog-studio-main .blog-editor-group {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .blog-studio-main .blog-editor-toolbar {
      padding: 10px 14px;
      background: #15131c;
      border-color: var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 5;
    }
    .blog-studio-main .blog-editor-canvas,
    .blog-studio-main .blog-editor-preview {
      flex: 1;
      min-height: 480px;
      background: #111016;
      border-color: var(--border-subtle);
      padding: 24px 28px;
      font-size: 15px;
      line-height: 1.85;
    }
    .blog-studio-sidebar {
      height: 100%;
      overflow-y: auto;
      background: #111017;
      border-left: 1px solid var(--border-subtle);
      padding: 26px 24px 60px;
    }
    .blog-sidebar-title {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    @media (max-width: 1100px) {
      .blog-studio-body { grid-template-columns: 1fr 320px; }
      .blog-studio-main { padding: 24px 24px 40px; }
      .blog-title-input { font-size: 20px; }
    }
    @media (max-width: 860px) {
      .blog-studio-body {
        display: flex;
        flex-direction: column;
        overflow-y: auto;
      }
      .blog-studio-form {
        height: auto;
        overflow-y: auto;
      }
      .blog-studio-main, .blog-studio-sidebar {
        height: auto;
        overflow: visible;
      }
      .blog-studio-sidebar {
        border-left: none;
        border-top: 1px solid var(--border-subtle);
      }
    }
  </style>

  <div class="collections-header">
    <div>
      <h2 style="font-size:22px;font-weight:800;color:#fff;">${config.title}</h2>
      <p style="font-size:12px;color:var(--text-muted);margin-top:2px;">Manage ${collectionType} entries — changes reflect immediately on the live site</p>
    </div>
    <button type="button" class="btn-action-gold" id="btnOpenNewItem">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Add New Entry
    </button>
  </div>

  ${items.length === 0 ? `<div class="glass-panel" style="text-align:center;padding:60px 24px;">
    <div style="font-size:36px;margin-bottom:12px;opacity:0.25;">📂</div>
    <p style="font-size:14px;font-weight:700;color:#fff;margin-bottom:4px;">No entries yet</p>
    <p style="font-size:12px;color:var(--text-muted);margin-bottom:20px;">Click below to add your first entry</p>
    <button type="button" class="btn-action-gold" onclick="document.getElementById('btnOpenNewItem').click()">+ Add First Entry</button>
  </div>` : `<div class="items-grid">
    ${items.map(item => `<div class="item-card" id="card_${item.id}">
      <div class="item-card-media" style="position:relative;overflow:hidden;background:#0d0c12;">
        ${collectionType === 'team' ? `
          <img src="${item.image || '/images/Flower.svg'}" alt="${item.name || item.title}" style="width:100%;height:100%;object-fit:cover;transition:opacity 0.3s ease;">
          ${item.altImage ? `<img src="${item.altImage}" alt="Hover Flip" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.3s ease;" onmouseenter="this.style.opacity='1'" onmouseleave="this.style.opacity='0'">` : ''}
          ${item.altImage ? `<span style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.8);color:#FFD700;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;border:1px solid rgba(255,215,0,0.35);pointer-events:none;">2 Images · Hover</span>` : ''}
        ` : ((item.image || item.coverImage || item.photo) ? `<img src="${item.image || item.coverImage || item.photo}" alt="${item.title || item.name}" onerror="this.parentElement.innerHTML='<div class=no-img>No Image</div>'">` : '<div class="no-img">No Image</div>')}
      </div>
      <div class="item-card-body">
        <div class="item-badge">${collectionType === 'team' ? ((item.department ? item.department.toUpperCase() + ' · ' : '') + (item.role || 'Member')) : (collectionType === 'works' ? (workCategories.find(category => category.value === item.category)?.label || item.category || 'Uncategorized') : (item.category || item.role || item.author || collectionType))}</div>
        <h3 class="item-title">${item.name || item.title || 'Untitled'}</h3>
        <p class="item-desc">${collectionType === 'team' ? `Flip: ${item.altName || item.name} · ${item.bio || item.role || '—'}` : (collectionType === 'works' ? `${item.client || ''}${item.highlightText ? ` · Highlight: ${item.highlightText}` : ''}${item.videoUrl ? ' · Hover video' : ''}${item.isActive === false ? ' · Hidden' : ''}` : (item.shortDesc || item.summary || item.excerpt || item.bio || '—'))}</p>
        <div class="item-actions">
          <button type="button" class="btn-edit-item" style="flex:1;" data-item="${JSON.stringify(item).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;").replace(/>/g,"&gt;")}" onclick="openEditModal(this.dataset.item)">Edit ✎</button>
          <button type="button" class="btn-del-item" onclick="deleteItem('${collectionKey}',${item.id})">✕</button>
        </div>
      </div>
    </div>`).join('')}
  </div>`}

  ${collectionType === 'blogs' ? `
  <div class="modal-backdrop blog-fullscreen-backdrop" id="itemModal">
    <div class="modal-box blog-fullscreen-modal">
      <div class="blog-studio-topbar">
        <div class="blog-studio-topbar-left">
          <button type="button" class="btn-studio-back" onclick="closeModal()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            <span>Back to Articles</span>
          </button>
          <div class="blog-studio-divider"></div>
          <div class="blog-studio-heading-wrap">
            <span class="blog-studio-badge">Blog Studio</span>
            <h3 id="modalHeading" class="blog-studio-title">Add New Article</h3>
          </div>
        </div>
        <div class="blog-studio-topbar-right">
          <div class="blog-studio-stat-pill" id="blogTopbarStats">0 words · 1 min read</div>
          <label class="blog-studio-toggle-label">
            <input type="checkbox" id="itemIsPublished" checked>
            <span>Publish Live</span>
          </label>
          <button type="button" class="btn-action-gold" onclick="document.getElementById('itemForm').requestSubmit()">
            Save Article ✦
          </button>
          <button type="button" class="btn-studio-close" onclick="closeModal()" title="Close (Esc)">✕</button>
        </div>
      </div>
      <form id="itemForm" class="blog-studio-form">
        <input type="hidden" id="itemId">
        <input type="hidden" id="itemImageUrl">
        <input type="hidden" id="itemAltImageUrl">
        
        <div class="blog-studio-body">
          <!-- Main Writing Area (Occupies full display left side) -->
          <div class="blog-studio-main">
            <div class="form-group" style="margin-bottom:16px;">
              <label class="form-label" style="font-size:11px;color:var(--gold);text-transform:uppercase;letter-spacing:0.08em;font-weight:800;margin-bottom:6px;">Article Title *</label>
              <input type="text" class="blog-title-input" id="itemTitle" required maxlength="200" placeholder="Enter article title...">
            </div>
            
            <div class="form-group blog-editor-group" style="flex:1;display:flex;flex-direction:column;">
              <div class="blog-editor-toolbar" role="toolbar" aria-label="Article formatting">
                <button type="button" data-markdown="## Heading\\n" title="Add section heading">H2</button>
                <button type="button" data-markdown="### Subheading\\n" title="Add subheading">H3</button>
                <button type="button" data-markdown="**Bold text**" title="Add bold text"><strong>B</strong></button>
                <button type="button" data-markdown="_Italic text_" title="Add italic text"><em>I</em></button>
                <button type="button" data-markdown="- List item\\n" title="Add bullet list">List</button>
                <button type="button" data-markdown="> Quote\\n" title="Add a quote">Quote</button>
                <button type="button" id="btnInsertBlogImage" title="Upload and insert an article image">🖼 Image</button>
                <div style="flex:1;"></div>
                <button type="button" id="btnPreviewBlog" aria-pressed="false" style="font-weight:700;">Preview</button>
              </div>
              <div class="blog-editor-canvas" id="blogRichEditor" contenteditable="true" role="textbox" aria-label="Article body" aria-multiline="true" data-placeholder="Write your article here. Use the toolbar above to format text and insert inline images..."></div>
              <textarea class="blog-editor-source" id="itemContent" aria-hidden="true" tabindex="-1"></textarea>
              <input type="file" id="blogInlineImageInput" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
              <div class="blog-editor-preview" id="blogEditorPreview" hidden></div>
              <div class="blog-editor-footer">
                <span id="blogWordCount">0 words · about 1 min read</span>
                <span>Pro-tip: Images stay visible while editing and are saved with the article.</span>
              </div>
            </div>
          </div>

          <!-- Publishing & SEO Inspector Sidebar -->
          <div class="blog-studio-sidebar">
            <div class="blog-sidebar-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              <span>Publishing Settings</span>
            </div>

            <!-- Cover Image -->
            <div class="form-group">
