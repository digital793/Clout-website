<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %></title>
  <link rel="icon" href="/images/group-c-logo.svg">
  <style>
    :root {
      --bg: #070709; --panel: #0f0f13; --panel-2: #16161c; --border: rgba(255,255,255,.08);
      --text: #f4f4f2; --muted: #8b8b95; --gold: #FFD700; --gold-soft: rgba(255,215,0,.12);
      --green: #2ed573; --red: #ff4757;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 13px; }
    button, input, textarea { font: inherit; color: inherit; }
    .studio { display: grid; grid-template-rows: 60px 1fr; height: 100vh; }

    /* top bar */
    .topbar { display: flex; align-items: center; gap: 14px; padding: 0 16px; border-bottom: 1px solid var(--border); background: var(--panel); }
    .back-btn { color: var(--gold); text-decoration: none; font-weight: 700; border: 1px solid rgba(255,215,0,.35); border-radius: 8px; padding: 7px 12px; white-space: nowrap; }
    .back-btn:hover { background: var(--gold-soft); }
    .page-name { font-weight: 800; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
    .page-name small { color: var(--muted); font-weight: 600; letter-spacing: 0; text-transform: none; margin-left: 6px; }
    .devices { margin: 0 auto; display: flex; background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px; padding: 3px; }
    .devices button { background: none; border: 0; padding: 6px 14px; border-radius: 7px; color: var(--muted); cursor: pointer; font-weight: 600; }
    .devices button.active { background: var(--gold); color: #000; }
    .status { color: var(--muted); white-space: nowrap; }
    .status.dirty { color: var(--gold); }
    .live-link { color: var(--muted); text-decoration: none; white-space: nowrap; }
    .live-link:hover { color: var(--text); }
    .publish-btn { background: var(--gold); color: #000; border: 0; border-radius: 8px; padding: 9px 16px; font-weight: 800; cursor: pointer; white-space: nowrap; }
    .publish-btn:disabled { opacity: .35; cursor: not-allowed; }

    .body { display: grid; grid-template-columns: 270px 1fr 330px; min-height: 0; }

    /* navigator */
    .nav { border-right: 1px solid var(--border); background: var(--panel); overflow-y: auto; padding: 12px 10px 40px; }
    .panel-title { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 4px 8px 10px; }
    .nav-section { margin-bottom: 6px; }
    .nav-section-head { display: flex; align-items: center; gap: 8px; padding: 7px 8px; font-weight: 700; color: var(--text); }
    .nav-section-head::before { content: ""; width: 10px; height: 8px; border-radius: 2px; background: var(--gold); opacity: .8; }
    .nav-item { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; text-align: left;
      background: none; border: 0; border-radius: 6px; padding: 6px 8px 6px 26px; color: var(--muted); cursor: pointer; }
    .nav-item:hover { background: rgba(255,255,255,.04); color: var(--text); }
    .nav-item.active { background: var(--gold); color: #000; font-weight: 700; }
    .nav-item .tag { font-size: 9px; font-weight: 800; letter-spacing: .06em; opacity: .7; }
    .nav-item .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); display: none; margin-left: auto; }
    .nav-item.changed .dot { display: inline-block; }
    .nav-item.active .dot { background: #000; }

    /* canvas */
    .canvas { background: #1b1b21; overflow: auto; display: flex; justify-content: center; padding: 18px; min-width: 0; position: relative; }
    .frame-wrap { width: 100%; height: 100%; transition: width .3s ease; background: #000; border-radius: 6px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,.5); }
    .frame-wrap.tablet { width: 768px; }
    .frame-wrap.phone { width: 390px; }
    iframe { width: 100%; height: 100%; border: 0; display: block; background: #000; }
    .loading { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); pointer-events: none; }

    /* inspector */
    .inspector { border-left: 1px solid var(--border); background: var(--panel); overflow-y: auto; padding: 14px 16px 40px; }
    .empty { color: var(--muted); line-height: 1.6; padding: 8px; }
    .field-label { font-size: 15px; font-weight: 800; margin: 4px 0 4px; }
    .field-key { font-family: ui-monospace, Consolas, monospace; font-size: 11px; color: var(--gold); background: var(--gold-soft); border: 1px solid rgba(255,215,0,.3); border-radius: 5px; padding: 2px 6px; display: inline-block; }
    .badge { display: inline-block; font-size: 10px; font-weight: 800; border-radius: 999px; padding: 2px 8px; margin-left: 6px; }
    .badge.saved { color: var(--green); border: 1px solid rgba(46,213,115,.4); }
    .badge.pending { color: var(--gold); border: 1px solid rgba(255,215,0,.4); }
    .group { margin-top: 18px; }
    .group-title { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    textarea, .url-input { width: 100%; background: #0a0a0d; border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; line-height: 1.5; outline: none; }
    textarea { min-height: 140px; resize: vertical; }
    textarea:focus, .url-input:focus { border-color: var(--gold); }
    .hint { color: var(--muted); font-size: 12px; line-height: 1.5; margin-top: 6px; }
    .note { margin-top: 12px; padding: 10px 12px; border-radius: 8px; background: rgba(255,215,0,.07); border: 1px solid rgba(255,215,0,.25); color: #f0dc8a; line-height: 1.5; font-size: 12px; }
    .img-preview { width: 100%; max-height: 200px; object-fit: contain; background: #0a0a0d; border: 1px solid var(--border); border-radius: 8px; display: block; }
    .row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .btn { background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; cursor: pointer; font-weight: 600; }
    .btn:hover { border-color: rgba(255,255,255,.2); }
    .btn.gold { background: var(--gold); color: #000; border-color: var(--gold); font-weight: 800; }
    .btn.danger { color: var(--red); }
    .btn:disabled { opacity: .4; cursor: not-allowed; }

    .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .g-item { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: #0a0a0d; border: 1px solid var(--border); }
    .g-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .g-num { position: absolute; top: 4px; left: 4px; background: rgba(0,0,0,.75); color: var(--gold); font-size: 10px; font-weight: 800; border-radius: 4px; padding: 1px 5px; }
    .g-tools { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; padding: 4px; background: linear-gradient(to top, rgba(0,0,0,.85), rgba(0,0,0,0)); }
    .g-btn { background: rgba(0,0,0,.7); border: 1px solid rgba(255,255,255,.2); color: #fff; border-radius: 5px; width: 24px; height: 22px; font-size: 11px; cursor: pointer; padding: 0; }
    .g-btn:hover { border-color: var(--gold); }
    .g-btn.g-del { color: var(--red); }
    .g-btn:disabled { opacity: .3; cursor: not-allowed; }
    .toast { position: fixed; right: 20px; bottom: 20px; background: #111; border: 1px solid var(--gold); color: var(--text); padding: 12px 16px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.6); opacity: 0; transform: translateY(10px); transition: all .25s ease; z-index: 10; }
    .toast.show { opacity: 1; transform: none; }
    .toast.error { border-color: var(--red); }

    @media (max-width: 1100px) { .body { grid-template-columns: 220px 1fr 280px; } .live-link, .status { display: none; } }
  </style>
</head>
<body>
<div class="studio">
  <header class="topbar">
    <a href="/admin/pages" class="back-btn" id="backBtn">&larr; Pages</a>
    <div class="page-name"><%= page.name %><small><%= page.path %></small></div>
    <div class="devices" role="group" aria-label="Preview size">
      <button type="button" data-device="desktop" class="active">Desktop</button>
      <button type="button" data-device="tablet">Tablet</button>
      <button type="button" data-device="phone">Phone</button>
    </div>
    <span class="status" id="status">No unpublished changes</span>
    <a href="<%= page.path %>" target="_blank" class="live-link">View page &#8599;</a>
    <button type="button" class="publish-btn" id="publishBtn" disabled>Publish &amp; Save</button>
  </header>

  <div class="body">
    <aside class="nav">
      <div class="panel-title">Page sections</div>
      <div id="navList"><div class="empty">Loading page…</div></div>
    </aside>

    <main class="canvas">
      <div class="frame-wrap" id="frameWrap">
        <iframe id="preview" title="Page preview" src="<%= page.path %>?studio=1"></iframe>
      </div>
      <div class="loading" id="loading">Loading preview…</div>
    </main>

    <aside class="inspector" id="inspector">
      <div class="panel-title">Edit</div>
      <div class="empty">Click any highlighted text or image on the page, or pick an item from the list on the left.</div>
    </aside>
  </div>
</div>
<div class="toast" id="toast"></div>

<script>
(function () {
  'use strict';
  var PAGE = <%- JSON.stringify(page.slug) %>;
  var SAVED = <%- JSON.stringify(edits || {}).replace(/</g, '\\u003c') %>; // published edits
  var SECTION_NAMES = PAGE === 'about' ? {
    hero: 'Hero', story: 'Our Story', principles: 'Guiding Principles', team: 'Meet Our Team',
    stories: 'Customer Stories', cta: 'Ready to Win'
  } : {
    hero: 'Hero (desktop)', heroMobile: 'Hero (phone)', clients: 'Our Clients', services: 'Our Services',
    stories: 'Customer Stories', work: 'Our Work', cta: 'Ready to Win', newsletter: 'Newsletter'
  };

  var frame = document.getElementById('preview');
  var navList = document.getElementById('navList');
  var inspector = document.getElementById('inspector');
  var publishBtn = document.getElementById('publishBtn');
  var statusEl = document.getElementById('status');

  var fields = {};      // key -> { key, label, type, els: [], original }
  var order = [];       // keys in page order
  var pending = {};     // key -> new value (string) or null (back to original)
  var selected = null;
  var doc = null;

  // ---------- helpers ----------
  function toast(msg, isError) {
    var t = document.getElementById('toast');
    t.textContent = msg; t.className = 'toast show' + (isError ? ' error' : '');
    clearTimeout(t._h); t._h = setTimeout(function () { t.className = 'toast'; }, 3200);
  }
  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

  // read an element's text the way an editor expects it (line breaks kept, source spacing collapsed)
  function readText(el) {
    var out = '';
    (function walk(node) {
      node.childNodes.forEach(function (n) {
        if (n.nodeType === 3) out += n.nodeValue.replace(/[ \t\r\n]+/g, ' ');
        else if (n.nodeName === 'BR') out += '\n';
        else if (n.nodeType === 1) walk(n);
      });
    })(el);
    return out.replace(/ *\n */g, '\n').replace(/^ +| +$/g, '');
  }
  function readValue(f) {
    var el = f.els[0];
    if (f.type === 'image') return el.getAttribute('src') || '';
    if (f.type === 'gallery') return Array.prototype.filter.call(el.querySelectorAll('img'), function (img) {
      return !img.closest('.splide__slide--clone');
    }).map(function (img) { return img.getAttribute('src') || ''; }).filter(Boolean).join('\n');
    if (f.type === 'list') return Array.prototype.map.call(el.querySelectorAll('li'), function (li) { return readText(li); }).join('\n');
    return readText(el);
  }
  function currentValue(key) {
    if (Object.prototype.hasOwnProperty.call(pending, key)) return pending[key] === null ? fields[key].original : pending[key];
    return readValue(fields[key]);
  }

  // write a value into the preview page
  function paint(key, value) {
    var f = fields[key];
    if (f.type === 'gallery') return; // the slider is rebuilt by the page after publishing
    f.els.forEach(function (el) {
      if (f.type === 'image') {
        el.removeAttribute('srcset'); el.removeAttribute('sizes'); el.setAttribute('src', value);
      } else if (f.type === 'list') {
        el.innerHTML = String(value).split('\n').map(function (s) { return s.trim(); }).filter(Boolean)
          .map(function (s) { return '<li>' + esc(s) + '</li>'; }).join('');
      } else {
        el.innerHTML = esc(value).replace(/\n/g, '<br>');
      }
    });
  }

  function isVisible(el) {
    if (!el.getClientRects().length) return false;
    var cs = doc.defaultView.getComputedStyle(el);
    return cs.visibility !== 'hidden' && cs.display !== 'none';
  }

  function updateStatus() {
    var n = Object.keys(pending).length;
    publishBtn.disabled = n === 0;
    publishBtn.textContent = n ? 'Publish & Save (' + n + ')' : 'Publish & Save';
    statusEl.textContent = n ? n + ' unpublished change' + (n > 1 ? 's' : '') : 'No unpublished changes';
    statusEl.className = 'status' + (n ? ' dirty' : '');
    navList.querySelectorAll('.nav-item').forEach(function (b) {
      b.classList.toggle('changed', Object.prototype.hasOwnProperty.call(pending, b.dataset.key));
    });
  }

  // ---------- navigator ----------
  function buildNav() {
    var groups = {};
    var groupOrder = [];
    order.forEach(function (key) {
      var sec = key.split('.')[0];
      if (!groups[sec]) { groups[sec] = []; groupOrder.push(sec); }
      groups[sec].push(key);
    });
    navList.innerHTML = groupOrder.map(function (sec) {
      return '<div class="nav-section"><div class="nav-section-head">' + esc(SECTION_NAMES[sec] || sec) + '</div>' +
        groups[sec].map(function (key) {
          var f = fields[key];
          var tag = f.type === 'image' ? 'IMG' : f.type === 'gallery' ? 'IMGS' : f.type === 'list' ? 'LIST' : 'TXT';
          return '<button type="button" class="nav-item" data-key="' + esc(key) + '"><span>' + esc(f.label) +
            '</span><span class="dot"></span><span class="tag">' + tag + '</span></button>';
        }).join('') + '</div>';
    }).join('');
    navList.querySelectorAll('.nav-item').forEach(function (b) {
      b.addEventListener('click', function () { select(b.dataset.key, true); });
    });
    updateStatus();
  }

  // ---------- inspector ----------
  function select(key, scroll) {
    selected = key;
    var f = fields[key];
    doc.querySelectorAll('.cms-selected').forEach(function (el) { el.classList.remove('cms-selected'); });
    f.els.forEach(function (el) { el.classList.add('cms-selected'); });
    navList.querySelectorAll('.nav-item').forEach(function (b) { b.classList.toggle('active', b.dataset.key === key); });
    var visibleEl = f.els.filter(isVisible)[0];
    if (scroll && visibleEl) visibleEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
    renderInspector(f, !!visibleEl);
  }

  function renderInspector(f, visible) {
    var isPending = Object.prototype.hasOwnProperty.call(pending, f.key);
    var isSaved = Object.prototype.hasOwnProperty.call(SAVED, f.key);
    var badge = isPending ? '<span class="badge pending">Unpublished</span>' : isSaved ? '<span class="badge saved">Edited</span>' : '';
    var value = currentValue(f.key);
    var html = '<div class="panel-title">Edit</div>' +
      '<div class="field-label">' + esc(f.label) + badge + '</div>' +
      '<span class="field-key">' + esc(f.key) + '</span>';

    if (f.type === 'gallery') {
      var imgs = String(value).split('\n').filter(Boolean);
      html += '<div class="group"><div class="group-title">Images in the slider (' + imgs.length + ')</div>' +
        '<div class="gallery">' + imgs.map(function (u, i) {
          return '<div class="g-item"><img src="' + esc(u) + '" alt=""><span class="g-num">' + (i + 1) + '</span>' +
            '<div class="g-tools">' +
            '<button type="button" class="g-btn" data-g="up" data-i="' + i + '" title="Move left"' + (i === 0 ? ' disabled' : '') + '>&larr;</button>' +
            '<button type="button" class="g-btn" data-g="down" data-i="' + i + '" title="Move right"' + (i === imgs.length - 1 ? ' disabled' : '') + '>&rarr;</button>' +
            '<button type="button" class="g-btn g-del" data-g="del" data-i="' + i + '" title="Remove"' + (imgs.length <= 2 ? ' disabled' : '') + '>&#10005;</button>' +
            '</div></div>';
        }).join('') + '</div>' +
        '<div class="row"><button type="button" class="btn gold" id="uploadBtn">+ Add image</button>' +
        '<input type="file" id="fileInput" accept="image/*" multiple hidden></div>' +
        '<div class="group-title" style="margin-top:14px">Or add by link</div>' +
        '<div class="row" style="margin-top:0"><input class="url-input" id="addUrl" placeholder="/images/photo.webp or https://…" style="flex:1">' +
        '<button type="button" class="btn" id="addUrlBtn">Add</button></div>' +
        '<div class="hint">Square images look best. The slider keeps at least 2 images.</div></div>' +
        '<div class="note">The slider on the preview updates after you click Publish &amp; Save.</div>';
    } else if (f.type === 'image') {
      html += '<div class="group"><div class="group-title">Image</div>' +
        '<img class="img-preview" id="imgPreview" src="' + esc(value) + '" alt="">' +
        '<div class="row"><button type="button" class="btn gold" id="uploadBtn">Upload new image</button>' +
        '<input type="file" id="fileInput" accept="image/*" hidden></div>' +
        '<div class="group-title" style="margin-top:14px">Or image link</div>' +
        '<input class="url-input" id="valueInput" value="' + esc(value) + '">' +
        '<div class="hint">A site path like /images/photo.webp, or a full https:// link.</div></div>';
    } else {
      html += '<div class="group"><div class="group-title">' + (f.type === 'list' ? 'Points (one per line)' : 'Text') + '</div>' +
        '<textarea id="valueInput" spellcheck="true">' + esc(value) + '</textarea>' +
        '<div class="hint">' + (f.type === 'list' ? 'Each line becomes one point.' : 'Press Enter for a line break.') + '</div></div>';
    }
    if (!visible) {
      html += '<div class="note">This item isn\'t visible on the preview at this size' +
        (PAGE !== 'home' ? '.' :
         f.key.indexOf('services.') === 0 ? ' — the services cube builds itself from this text when the page loads. Publish, then the cube shows the new text.' :
         f.key.indexOf('heroMobile.') === 0 ? '. Switch to Phone to see it.' : f.key.indexOf('hero.') === 0 ? '. Switch to Desktop to see it.' : '.') + '</div>';
    }
    html += '<div class="row" style="margin-top:18px">' +
      '<button type="button" class="btn" id="undoBtn"' + (isPending ? '' : ' disabled') + '>Undo changes</button>' +
      '<button type="button" class="btn danger" id="revertBtn"' + (isSaved && !(isPending && pending[f.key] === null) ? '' : ' disabled') + '>Restore original</button></div>' +
      '<div class="hint">"Restore original" brings back the text or image the page was built with, after you publish.</div>';
    inspector.innerHTML = html;

    if (f.type === 'gallery') {
      // image list: reorder, remove, add by upload or link
      var list = String(value).split('\n').filter(Boolean);
      var commit = function (next) { setPending(f.key, next.join('\n')); renderInspector(f, visible); };
      inspector.querySelectorAll('[data-g]').forEach(function (b) {
        b.addEventListener('click', function () {
          var i = Number(b.dataset.i), next = list.slice();
          if (b.dataset.g === 'up' && i > 0) { next.splice(i - 1, 0, next.splice(i, 1)[0]); }
          if (b.dataset.g === 'down' && i < next.length - 1) { next.splice(i + 1, 0, next.splice(i, 1)[0]); }
          if (b.dataset.g === 'del' && next.length > 2) { next.splice(i, 1); }
          commit(next);
        });
      });
      var gFile = document.getElementById('fileInput');
      document.getElementById('uploadBtn').addEventListener('click', function () { gFile.click(); });
      gFile.addEventListener('change', function () {
        var files = Array.prototype.slice.call(gFile.files);
        if (!files.length) return;
        var btn = document.getElementById('uploadBtn');
        btn.disabled = true; btn.textContent = 'Uploading…';
        files.reduce(function (p, file) {
          return p.then(function (urls) {
            var fd = new FormData(); fd.append('file', file);
            return fetch('/api/admin/studio-upload', { method: 'POST', body: fd, headers: { Accept: 'application/json' } })
              .then(function (r) { return r.json(); })
              .then(function (res) { if (!res.success) throw new Error(res.error || 'Upload failed'); return urls.concat(res.url); });
          });
        }, Promise.resolve([]))
          .then(function (urls) {
            commit(list.concat(urls));
            toast(urls.length + ' image' + (urls.length > 1 ? 's' : '') + ' added — click Publish & Save to put them live');
          })
          .catch(function (e) { toast(e.message, true); renderInspector(f, visible); });
      });
      var addUrl = document.getElementById('addUrl');
      var addByLink = function () {
        var u = addUrl.value.trim();
        if (!/^(\/(?!\/)|https?:\/\/)[^"<>\s]+$/i.test(u)) { toast('Use a site path like /images/photo.webp or an https:// link', true); return; }
        commit(list.concat(u));
      };
      document.getElementById('addUrlBtn').addEventListener('click', addByLink);
      addUrl.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addByLink(); } });
    } else {
      var input = document.getElementById('valueInput');
      input.addEventListener('input', function () {
        setPending(f.key, input.value);
        if (f.type === 'image') document.getElementById('imgPreview').src = input.value;
      });
    }
    if (f.type === 'image') {
      var fileInput = document.getElementById('fileInput');
      document.getElementById('uploadBtn').addEventListener('click', function () { fileInput.click(); });
      fileInput.addEventListener('change', function () { if (fileInput.files[0]) uploadImage(f, fileInput.files[0]); });
    }
    document.getElementById('undoBtn').addEventListener('click', function () {
      delete pending[f.key];
      paint(f.key, Object.prototype.hasOwnProperty.call(SAVED, f.key) ? SAVED[f.key] : f.original);
      updateStatus(); select(f.key, false);
    });
    document.getElementById('revertBtn').addEventListener('click', function () {
      pending[f.key] = null;
      paint(f.key, f.original);
      updateStatus(); select(f.key, false);
    });
  }

  function setPending(key, value) {
    // what's live now: the published edit, or the original if never edited
    var live = Object.prototype.hasOwnProperty.call(SAVED, key) ? SAVED[key] : fields[key].original;
    if (value === live) delete pending[key];
    else pending[key] = value;
    paint(key, value);
    updateStatus();
    var badgeHost = inspector.querySelector('.field-label');
    if (badgeHost && !badgeHost.querySelector('.badge.pending') && pending.hasOwnProperty(key)) {
      var old = badgeHost.querySelector('.badge'); if (old) old.remove();
      badgeHost.insertAdjacentHTML('beforeend', '<span class="badge pending">Unpublished</span>');
    }
    var undo = document.getElementById('undoBtn'); if (undo) undo.disabled = !pending.hasOwnProperty(key);
  }

  function uploadImage(f, file) {
    var btn = document.getElementById('uploadBtn');
    btn.disabled = true; btn.textContent = 'Uploading…';
    var fd = new FormData(); fd.append('file', file);
    fetch('/api/admin/studio-upload', { method: 'POST', body: fd, headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (!res.success) throw new Error(res.error || 'Upload failed');
        document.getElementById('valueInput').value = res.url;
        document.getElementById('imgPreview').src = res.url;
        setPending(f.key, res.url);
        toast('Image uploaded — click Publish & Save to put it live');
      })
      .catch(function (e) { toast(e.message, true); })
      .finally(function () { btn.disabled = false; btn.textContent = 'Upload new image'; });
  }

  // ---------- publish ----------
  publishBtn.addEventListener('click', function () {
    var body = { fields: pending };
    publishBtn.disabled = true; publishBtn.textContent = 'Publishing…';
    fetch('/api/admin/studio/' + PAGE, {
      method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body)
    })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (!res.success) throw new Error(res.error || 'Publish failed');
        Object.keys(pending).forEach(function (k) {
          if (pending[k] === null) delete SAVED[k]; else SAVED[k] = pending[k];
        });
        pending = {};
        toast('Published — the page is updated');
        reloadPreview();
      })
      .catch(function (e) { toast(e.message, true); updateStatus(); });
  });

  // ---------- preview frame ----------
  function reloadPreview() {
    document.getElementById('loading').style.display = 'grid';
    frame.contentWindow.location.reload();
  }

  // originals: read from the untouched page template (fetched once, not run)
  var ORIGINALS = {};
  var originalsReady = fetch(<%- JSON.stringify(page.path) %> + '?studio=original', { credentials: 'same-origin' })
    .then(function (r) { return r.text(); })
    .then(function (html) {
      var raw = new DOMParser().parseFromString(html, 'text/html');
      raw.querySelectorAll('[data-cms]').forEach(function (el) {
        var key = el.getAttribute('data-cms');
        if (Object.prototype.hasOwnProperty.call(ORIGINALS, key)) return;
        var f = { type: el.getAttribute('data-cms-type') || 'text', els: [el] };
        ORIGINALS[key] = readValue(f);
      });
    })
    .catch(function () { /* fall back to reading the preview */ });

  frame.addEventListener('load', function () {
    originalsReady.then(onFrameLoad);
  });
  // in case the preview finished loading before this script ran
  try {
    var d0 = frame.contentDocument;
    if (d0 && d0.readyState === 'complete' && d0.location.href !== 'about:blank') originalsReady.then(onFrameLoad);
  } catch (e) {}

  function onFrameLoad() {
    doc = frame.contentDocument;
    document.getElementById('loading').style.display = 'none';
    var style = doc.createElement('style');
    style.textContent =
      '[data-cms]{cursor:pointer !important; pointer-events:auto !important; transition:outline-color .15s}' +
      '.floating-visual,#floating-visual{display:none !important}' +
      '[data-cms]:hover{outline:2px dashed rgba(255,215,0,.75) !important; outline-offset:3px}' +
      '.cms-selected{outline:2px solid #FFD700 !important; outline-offset:3px}' +
      '.custom-cursor{display:none !important}';
    doc.head.appendChild(style);

    // collect editable elements in page order
    fields = {}; order = [];
    // sliders copy slides for looping; copies get edits too but don't set the list order
    var all = Array.prototype.slice.call(doc.querySelectorAll('[data-cms]'));
    var isCopy = function (el) { return !!el.closest('.splide__slide--clone'); };
    all.filter(function (el) { return !isCopy(el); }).concat(all.filter(isCopy)).forEach(function (el) {
      var key = el.getAttribute('data-cms');
      if (!fields[key]) {
        fields[key] = { key: key, label: el.getAttribute('data-cms-label') || key,
          type: el.getAttribute('data-cms-type') || 'text', els: [] };
        order.push(key);
      }
      fields[key].els.push(el);
    });
    // "original" = what the page template had (published edits replace it, so fall back to the saved snapshot)
    order.forEach(function (key) {
      var f = fields[key];
      f.original = Object.prototype.hasOwnProperty.call(ORIGINALS, key) ? ORIGINALS[key] : readValue(f);
    });
    // keep unpublished edits visible after a reload
    Object.keys(pending).forEach(function (k) { if (fields[k] && pending[k] !== null) paint(k, pending[k]); });

    // clicking in the preview selects instead of following links
    doc.addEventListener('click', function (e) {
      var target = e.target.closest ? e.target.closest('[data-cms]') : null;
      if (target) { e.preventDefault(); e.stopPropagation(); select(target.getAttribute('data-cms'), false); return; }
      if (e.target.closest && e.target.closest('a')) e.preventDefault();
    }, true);
    doc.addEventListener('submit', function (e) { e.preventDefault(); }, true);

    buildNav();
    if (selected && fields[selected]) select(selected, true);
  }

  // ---------- device switch ----------
  document.querySelectorAll('.devices button').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('.devices button').forEach(function (x) { x.classList.remove('active'); });
      b.classList.add('active');
      document.getElementById('frameWrap').className = 'frame-wrap' + (b.dataset.device === 'desktop' ? '' : ' ' + b.dataset.device);
      // the page sets up its layout and animations for the screen size on load, so reload at the new size
      setTimeout(reloadPreview, 320);
    });
  });

  window.addEventListener('beforeunload', function (e) {
    if (Object.keys(pending).length) { e.preventDefault(); e.returnValue = ''; }
  });
})();
</script>
</body>
</html>
