  <!-- Global Overrides -->
  <style>
    /* Map Webflow's unspaced font name 'Familjengrotesk' to Google Fonts 'Familjen Grotesk' & local TTF files */
    @font-face {
      font-family: 'Familjengrotesk';
      src: local('Familjen Grotesk Bold'), local('Familjen Grotesk'), url('/fonts/FamiljenGrotesk-Bold.ttf') format('truetype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Familjengrotesk';
      src: local('Familjen Grotesk Regular'), local('Familjen Grotesk'), url('/fonts/FamiljenGrotesk-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Familjengrotesk';
      src: local('Familjen Grotesk SemiBold'), local('Familjen Grotesk'), url('/fonts/FamiljenGrotesk-SemiBold.ttf') format('truetype');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Familjengrotesk';
      src: local('Familjen Grotesk Medium'), local('Familjen Grotesk'), url('/fonts/FamiljenGrotesk-Medium.ttf') format('truetype');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }

    /* Footer logo font style matching live site (Familjen Grotesk sans-serif) */
    .footer_v2_logo_content {
      font-family: 'Familjen Grotesk', 'Familjengrotesk', sans-serif !important;
    }

    body {
      -webkit-font-smoothing: antialiased;
      -moz-font-smoothing: antialiased;
      -o-font-smoothing: antialiased;
    }
    /* Fix for select dropdown options */
    select {
      background-color: #111111 !important;
      color: #ffffff !important;
    }
    select option {
      background-color: #111111 !important;
      color: #ffffff !important;
    }
    select option:hover, select option:focus, select option:checked {
      background-color: #2a2a2a !important;
      color: #ffffff !important;
    }
  </style>

