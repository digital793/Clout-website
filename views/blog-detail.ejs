<%- include('partials/head', {
  title,
  meta,
  currentPath,
  bodyClass: 'blog-detail-body',
  extraHead: "<link href=\"/css/pages/blog-detail.css\" rel=\"stylesheet\" type=\"text/css\">"
}) %>

<%- include('partials/navbar') %>

<main class="blog-article">
  <a class="blog-article-back" href="/blog">← All articles</a>
  <article>
    <img class="blog-article-cover" src="<%= blog.coverImage %>" alt="<%= blog.title %>">
    <div class="blog-article-meta">
      <div class="blog-article-tags">
        <% (Array.isArray(blog.tags) ? blog.tags : []).forEach(tag => { %>
        <span><%= tag %></span>
        <% }); %>
      </div>
      <div><%= blog.publishedAt || '' %><%= blog.readTime ? ` · ${blog.readTime}` : '' %></div>
    </div>
    <h1><%= blog.title %></h1>
    <% if (blog.author) { %><p class="blog-article-author">By <%= blog.author %></p><% } %>
    <p class="blog-article-lead"><%= blog.excerpt %></p>
    <div class="blog-article-content"><%- contentHtml %></div>
  </article>
  <a class="blog-article-back blog-article-bottom-link" href="/blog">← Back to all articles</a>
</main>

<%- include('partials/footer', { extraScripts: "" }) %>
