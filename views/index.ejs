        <div class="code-embed-16 w-embed w-script"><!--  ============================================================
  CHERRINET — Video Testimonial Scroller (native <video>, data-driven)
  Paste into a Webflow Embed block. Section inner container:
  max-width 1280px, padding 0 20px (standard Webflow layout).
  HOW TO ADD / REORDER VIDEOS
  ----------------------------------------------------------------
  Everything is generated from the TESTIMONIALS array near the top
  of the <script> block below. Cards are no longer written by hand
  in the HTML — there is exactly one place to edit.
  - To ADD a video: add one object to the TESTIMONIALS array.
  - To REORDER: reorder the objects in the array. That's it —
    card markup, quote text, and dot count all update automatically.
  - To REMOVE: delete the object.
  Works with any number of videos ≥ 2 (tested with 3–8).
============================================================  -->
          <style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;800&display=swap');
  .ch-wrap *, .ch-wrap *::before, .ch-wrap *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }
  .ch-wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 20px 48px;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #000;
    color: #FFF8DB;
    overflow: hidden;
  }
  .ch-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #FFD700;
    text-align: center;       /* centred above the heading */
    margin-bottom: 10px;
  }
  .ch-qmark[hidden],
  .ch-qtext[hidden] {
    display: none;
    text-align: center;
    margin-bottom: 10px;
  }
  .ch-heading {
    font-family: 'Lufga', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(32px, 3.2vw, 40px);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
    color: #FFF8DB;
    text-align: center;
    line-height: 1.05;
    margin-bottom: 36px;
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
  }
  /* ── Stage ── */
  .ch-stage {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 36px;
  }
  /* ── Card base ── */
  .ch-card {
    position: absolute;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    background: #1a1a1a;
    transition:
      transform 0.55s cubic-bezier(.4,0,.2,1),
      opacity   0.55s cubic-bezier(.4,0,.2,1),
      box-shadow 0.55s cubic-bezier(.4,0,.2,1);
    will-change: transform, opacity;
  }
  /* Cards not in the visible left/center/right window are parked
     out of the way instead of stacking at center (matters once
     more than 3 videos are in the array). */
  .ch-card.ch-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(0) scale(0.7);
    z-index: 0;
  }
  /* ── Video element — always in the DOM, no iframe ── */
  .ch-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
    display: block;
    background: #000;
    opacity: 0;
    transition: opacity .18s ease;
  }
  .ch-poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ch-card.has-frame .ch-video {
    opacity: 1;
  }
  /* ── Play button ── */
  .ch-play-btn {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 60px; height: 60px;
    border-radius: 50%;
    background: rgba(0,0,0,0.93);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, opacity 0.2s, visibility 0.2s;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    z-index: 6;
  }
  .ch-play-btn svg,
  .ch-sound-btn svg {
    width: 24px; height: 24px;
    fill: #FFD700;
  }
  .ch-play-btn { border: 0; padding: 0; cursor: pointer; opacity: 0; visibility: hidden; pointer-events: none; }
  .ch-play-btn.show { opacity: 0; visibility: hidden; pointer-events: none; }
  .ch-card.ch-center:hover .ch-play-btn.show,
  .ch-card.ch-center .ch-play-btn.show:focus-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .ch-card.ch-center:hover .ch-play-btn.show {
    transform: translate(-50%,-50%) scale(1.1);
  }
  .ch-sound-btn {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 7;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50%;
    background: rgba(0,0,0,.78);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .2s, visibility .2s, transform .2s, background .2s;
  }
  .ch-sound-btn.show { opacity: 1; visibility: visible; pointer-events: auto; }
  .ch-sound-btn:hover { background: #171717; transform: scale(1.08); }
  .ch-sound-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #FFD700;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* ── Position states (3-card visible window: left / center / right) ── */
  .ch-card.ch-left   { z-index: 1; opacity: 0.45; }
  .ch-card.ch-center { z-index: 5; opacity: 1; box-shadow: 0 28px 70px rgba(0,0,0,0.3); }
  .ch-card.ch-right  { z-index: 1; opacity: 0.45; }
  /* ── Nav buttons ── */
  .ch-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px; height: 42px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 20;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: background .22s, transform .22s, box-shadow .22s;
  }
  .ch-nav svg {
    width: 18px; height: 18px;
    stroke: currentColor; fill: none;
    stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
  }
  .ch-nav.ch-prev { left: 0; }
  .ch-nav.ch-next { right: 0; }
  /* ── Quote ── */
  .ch-quote {
    max-width: 600px;
    margin: 0 auto 24px;
    padding: 0 20px;
    text-align: left;
  }
  .ch-qmark {
    display: block;
    font-size: 60px; line-height: 1;
    color: #FFD700; opacity: 0.45;
    font-family: Georgia, serif;
    letter-spacing: -4px;
    margin-bottom: 6px;
    user-select: none;
  }
  .ch-qtext {
    font-size: 15px; color: #BDBBB0;
    line-height: 1.75;
    min-height: 60px;
    transition: opacity .22s;
  }
  .ch-qtext.fade { opacity: 0; }
  .ch-author {
    display: flex; align-items: center; gap: 12px;
    margin-top: 16px;
    transition: opacity .22s;
  }
  .ch-author.fade { opacity: 0; }
  .ch-author-info { display: flex; flex-direction: column; gap: 2px; }
  .ch-name { font-size: 14px; font-weight: 700; color: #FFF8DB; }
  .ch-role { font-size: 12px; color: #888; }
  /* ── Dots ── */
  .ch-dots {
    display: flex; gap: 7px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .ch-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #ccc; border: none; padding: 0; cursor: pointer;
    transition: background .3s, width .3s;
  }
  .ch-dot.active { background: #FFD700; width: 22px; border-radius: 5px; }
  /* ══════════════════════
     TABLET / SMALL DESKTOP  768px – 1023px
  ══════════════════════ */
  @media (min-width: 768px) {
    .ch-stage { height: 480px; }
    .ch-card  { width: 220px; height: 390px; }
    .ch-card.ch-left   { transform: translateX(-240px) scale(0.82); }
    .ch-card.ch-center { transform: translateX(0) scale(1); }
    .ch-card.ch-right  { transform: translateX(240px) scale(0.82); }
    .ch-nav {
      background: transparent;
      border: 1.5px solid #bbb;
      color: #888;
    }
    .ch-nav:hover {
      background: #FFD700; border-color: #FFD700; color: #000000;
      box-shadow: 0 4px 18px rgba(229,57,53,.38);
      transform: translateY(-50%) scale(1.12);
    }
    .ch-nav:active { transform: translateY(-50%) scale(0.94); }
