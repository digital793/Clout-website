          <script>
(function () {
  /* ============================================================
     SINGLE SOURCE OF TRUTH — edit here only.
     Order in this array = display order (left→right through the
     scroller). Add an object to add a video. Reorder objects to
     reorder the videos. Works with any count ≥ 2.
  ============================================================ */
  const TESTIMONIALS = [
    // Order matters: the carousel opens on the FIRST entry (centre),
    // the second shows on its right and the LAST shows on its left.
    // DRA / Superchennai is always featured first.
    {
      video: "/videos/testimonials/optimized/dra-ranjeeth-coloured-1.web.mp4",
      poster: "/videos/testimonials/dra-ranjeeth-coloured-1.jpg",
      text: "Cloutgency understands what Gen-Z & Gen Alpha audience want, they bring fresh and vibrant ideas to life.",
      name: "Ranjeeth Rathod",
      role: "MD - DRA Homes, Superchennai"
    },
    {
      video: "/videos/testimonials/optimized/dr-b-testimonial.web.mp4",
      poster: "/videos/testimonials/dr-b-testimonial.jpg",
      text: "Cloutgency delivered exactly what I envisioned for my clinic - creative, sharp, receptive. Two years in, and I've found family in this team",
      name: "Dr. Bhairavi Senthil",
      role: "Founder - DR.B 360 DERMATOLOGY EXPERIENTIAL CENTER"
    },
    {
      video: "/videos/testimonials/optimized/soft-serve-testimony.web.mp4",
      poster: "/videos/testimonials/soft-serve-testimony.jpg",
      text: "Cloutgency is doing a phenomenal job in the marketing game, their team of fresh & talented minds are easy to work with.",
      name: "Anush Rajasekaran",
      role: "Co-Founder - Soft Serve.co"
    },
    {
      video: "/videos/testimonials/optimized/rajparis-testimonial-updated-version.web.mp4",
      poster: "/videos/testimonials/rajparis-testimonial-updated-version.jpg",
      text: "",
      name: "Rajparis",
      role: "Client testimonial"
    },
    {
      video: "/videos/testimonials/optimized/murali-testimonial-final.web.mp4",
      poster: "/videos/testimonials/murali-testimonial-final.jpg",
      text: "",
      name: "Murali",
      role: "Client testimonial"
    },
    {
      video: "/videos/testimonials/optimized/anantha-testimonial.web.mp4",
      poster: "/videos/testimonials/anantha-testimonial.jpg",
      text: "",
      name: "Anantha",
      role: "Client testimonial"
    },
    {
      video: "/videos/testimonials/optimized/dra-x-cloutgency-v1.web.mp4",
      poster: "/videos/testimonials/dra-x-cloutgency-v1.jpg",
      text: "Clout team made an exceptional job in scaling our social media presence in a very short time, it's been a fun & exciting journey with them.",
      name: "Manoj Vasudevan",
      role: "Head of Sales & Marketing - DRA Homes"
    }
  ];
  const PLAY_ICON_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
  const PAUSE_ICON_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM15 5h4v14h-4z"/></svg>';
  const SOUND_ON_ICON_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4zM15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>';
  const SOUND_OFF_ICON_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4zM16 9l5 6M21 9l-5 6"/></svg>';
  const TOTAL          = TESTIMONIALS.length;
  const stage  = document.getElementById('chStage');
  const dotsEl = document.getElementById('chDots');
  const nextBtn = document.getElementById('chNext');
  /* ── Build cards from the array ── */
  const cards = TESTIMONIALS.map((t, i) => {
    const card = document.createElement('div');
    card.className = 'ch-card';
    card.dataset.index = i;
    card.innerHTML =
      '<img class="ch-poster" src="' + t.poster + '" alt="" aria-hidden="true" loading="eager" decoding="sync">' +
      '<video class="ch-video" preload="none" playsinline muted poster="' + t.poster + '" src="' + t.video + '"></video>' +
      '<button class="ch-play-btn" type="button" aria-label="Play testimonial video">' + PLAY_ICON_SVG + '</button>' +
      '<button class="ch-sound-btn" type="button" aria-label="Unmute video" title="Unmute video">' + SOUND_OFF_ICON_SVG + '</button>';
    stage.insertBefore(card, nextBtn);
    return card;
  });
  /* ── Build dots from the array ── */
  const dots = TESTIMONIALS.map((_, i) => {
    const dot = document.createElement('button');
    dot.className = 'ch-dot' + (i === 0 ? ' active' : '');
    dot.setAttribute('aria-label', 'Slide ' + (i + 1));
    dotsEl.appendChild(dot);
    return dot;
  });
  const quoteEl  = document.getElementById('chQuote');
  const quoteMarkEl = document.querySelector('.ch-qmark');
  const authorEl = document.getElementById('chAuthor');
  const nameEl   = document.getElementById('chName');
  const roleEl   = document.getElementById('chRole');
  let current   = 0;
  let animating = false;
  /* ── Position class for card i given current center.
     Only the 3 cards nearest current get left/center/right;
     everything else is parked off-screen (ch-hidden). This is
     what lets the array grow past 3 without breaking layout. ── */
  function posClass(i) {
    const off = ((i - current + TOTAL) % TOTAL);
    if (off === 0) return 'ch-center';
    if (off === 1) return 'ch-right';
    if (off === TOTAL - 1) return 'ch-left';
    return 'ch-hidden';
  }
  function killAllVideos() {
    cards.forEach(card => {
      card.classList.remove('playing');
      const vid = card.querySelector('.ch-video');
      if (vid) {
        vid.pause();
        vid.currentTime = 0;
        vid.preload = 'none';
        vid.muted = true;
        card.classList.remove('has-frame');
      }
    });
  }
  function applyQuote() {
    const t = TESTIMONIALS[current];
    quoteEl.textContent = t.text;
    quoteEl.hidden = !t.text;
    quoteMarkEl.hidden = !t.text;
    nameEl.textContent  = t.name;
    roleEl.textContent  = t.role;
  }
  function syncPlayBtn() {
    cards.forEach((card, i) => {
      const btn = card.querySelector('.ch-play-btn');
      const soundBtn = card.querySelector('.ch-sound-btn');
      const vid = card.querySelector('.ch-video');
      const isCenter  = posClass(i) === 'ch-center';
      const isPlaying = !vid.paused && !vid.ended;
      btn.classList.toggle('show', isCenter);
      btn.innerHTML = isPlaying ? PAUSE_ICON_SVG : PLAY_ICON_SVG;
      btn.setAttribute('aria-label', isPlaying ? 'Pause testimonial video' : 'Play testimonial video');
      soundBtn.classList.toggle('show', isCenter);
      soundBtn.innerHTML = vid.muted ? SOUND_OFF_ICON_SVG : SOUND_ON_ICON_SVG;
      soundBtn.setAttribute('aria-label', vid.muted ? 'Unmute video' : 'Mute video');
      soundBtn.title = vid.muted ? 'Unmute video' : 'Mute video';
    });
  }
  function updateUI(animate) {
    cards.forEach((c, i) => { c.className = 'ch-card ' + posClass(i); });
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
    if (animate) {
      quoteEl.classList.add('fade');
      authorEl.classList.add('fade');
      setTimeout(() => {
        applyQuote();
        quoteEl.classList.remove('fade');
        authorEl.classList.remove('fade');
      }, 220);
    } else {
      applyQuote();
    }
    syncPlayBtn();
  }
  function goTo(idx) {
    if (animating || idx === current) return;
    animating = true;
    killAllVideos();
    current = idx;
    updateUI(true);
    setTimeout(() => { animating = false; }, 580);
  }
  function rotate(dir) { goTo((current + dir + TOTAL) % TOTAL); }
  /* Side cards navigate; only the center play button starts its video. */
  cards.forEach((card, i) => {
    card.addEventListener('click', () => {
      const pos = posClass(i);
      if (pos === 'ch-left' || pos === 'ch-right') { goTo(i); return; }
    });
    const vid = card.querySelector('.ch-video');
    const playBtn = card.querySelector('.ch-play-btn');
    const soundBtn = card.querySelector('.ch-sound-btn');
    playBtn.addEventListener('click', () => {
      if (posClass(i) !== 'ch-center') return;
      if (!vid.paused && !vid.ended) {
        vid.pause();
        return;
      }
      vid.preload = 'auto';
      vid.muted = false;
      vid.play().catch(error => {
        console.error('Unable to play testimonial video:', vid.currentSrc, error);
      });
    });
    soundBtn.addEventListener('click', () => {
      if (posClass(i) !== 'ch-center') return;
      vid.muted = !vid.muted;
      syncPlayBtn();
    });
    vid.addEventListener('play', () => {
      card.classList.add('playing');
      syncPlayBtn();
    });
    vid.addEventListener('pause', () => {
      card.classList.remove('playing');
      syncPlayBtn();
    });
    vid.addEventListener('ended', syncPlayBtn);
    vid.addEventListener('timeupdate', () => {
      if (vid.currentTime > 0.2) card.classList.add('has-frame');
    });
    vid.addEventListener('error', () => {
      card.classList.remove('has-frame');
      console.error('Unable to load testimonial video:', vid.currentSrc, vid.error);
    });
  });
  document.getElementById('chPrev').addEventListener('click', () => rotate(-1));
  document.getElementById('chNext').addEventListener('click', () => rotate(1));
  dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
  let touchX = 0;
  stage.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 44) rotate(dx < 0 ? 1 : -1);
  }, { passive: true });
  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft')  rotate(-1);
    if (e.key === 'ArrowRight') rotate(1);
  });
  updateUI(false);
})();
</script>
